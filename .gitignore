# Dependencias — se instalan desde package-lock.json, no se versionan.
node_modules/
node_modules_corrupto*/

# APKs — 125 MB+ cada uno. Un repo con GBs de binarios es un repo que
# nadie clona. Se generan con gradle (ver mobile/README.md).
*.apk

# Nativo de mobile/ — expo prebuild lo regenera desde app.config.ts.
mobile/android/
mobile/ios/
mobile/.expo/

# Build/dist genéricos (backend y mobile).
dist/
build/

# Credenciales — NUNCA se versionan. Una credencial versionada es una
# credencial filtrada en cuanto este repo tenga un remoto. Incluye
# .env.example a propósito: nadie con permiso lo revisó todavía para
# confirmar que no tiene un valor real filtrado por error (ver
# mobile/README.md / decisión del 2026-09-03).
.env
.env.*
_env_nuevo.txt

# Índices de herramientas de análisis — se regeneran solos desde el código y
# son de CADA checkout: su contenido depende de la ruta absoluta del clon y de
# los bytes que ese clon tenga en disco. Versionarlos haría que dos personas se
# pisaran el índice en cada commit, y el del otro nunca serviría.
.atl/
.codegraph/

# Editor / SO / Temporales.
.DS_Store
Thumbs.db
*.log
_*.xml
mobile/design/_*
.claude/*.lock


# El Excel del cliente (INVENTARIO MES DE JULIO ... .xlsx) — NO se versiona.
# Su hoja ASISTENCIA trae nombres y DNI de personas reales, y este repo tiene
# remoto en GitHub: subirlo publica datos personales de la gente de la tienda.
# Las transcripciones sí quedan (ya estaban versionadas) porque son la fuente
# de los requisitos. Si algún día hace falta el formato del Excel, se replica
# en un archivo de ejemplo con datos inventados.
requerimiento/*.xlsx
