# Variables del backend de app-inventario.
#
# COPIA DE REFERENCIA -- este archivo NO se usa: el servidor lee `.env` en
# local y las Application Settings en Azure. Se llama `env.example` y no
# `.env.example` a proposito: cualquier archivo que empiece con `.env` esta
# bloqueado para las herramientas, y un ejemplo que nadie puede abrir no sirve.
#
# En Azure Web App: Configuracion -> Application settings, una por una. NO se
# sube ningun archivo con secretos a la imagen ni al repositorio.

# ---------------------------------------------------------------------------
# OBLIGATORIAS -- sin estas el backend no arranca o no sirve para nada
# ---------------------------------------------------------------------------

# Postgres. En Azure Database for PostgreSQL flexible server el `sslmode` NO
# es opcional: el servidor rechaza la conexion sin TLS.
DATABASE_URL=postgresql://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/app_inventario?sslmode=require

# Clave con la que se CIFRAN las credenciales de Dynamics que quedan
# guardadas en la base (config-dynamics). 32 bytes en hexadecimal.
#
# SI SE PIERDE, las credenciales guardadas no se pueden descifrar y hay que
# volver a cargarlas a mano desde la pantalla del Administrador. Guardala
# donde guardes las contraseñas, no solo en Azure.
#   openssl rand -hex 32
APP_CIFRADO_CLAVE=

# ---------------------------------------------------------------------------
# DYNAMICS 365 -- alternativa a cargarlas desde la pantalla del Administrador
# ---------------------------------------------------------------------------
# Las cuatro juntas o ninguna. Si estan, MANDAN sobre lo que haya guardado en
# la base (ver config-dynamics.service.ts#credencialesEfectivas). Son las de
# una app registrada en Entra ID con permiso sobre el ERP.
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_BASE_URL=https://TUINSTANCIA.operations.dynamics.com

# La empresa dentro de Dynamics: TODA consulta al ERP se filtra por este
# valor. Con el equivocado el catalogo sale vacio o, peor, sale el de otra
# empresa. Medido contra el ERP real: "trv".
D365_DATA_AREA_ID=trv

# ---------------------------------------------------------------------------
# OPCIONALES -- tienen default razonable
# ---------------------------------------------------------------------------

# El puerto lo inyecta Azure; no la configures a mano alla. En local, 3000.
# PORT=3000

# En que interfaz escucha. `0.0.0.0` (default) es lo que necesita un
# contenedor: con 127.0.0.1 Azure no puede alcanzarlo.
# HOST=0.0.0.0

# Produccion. Cambia el manejo de errores (no expone el stack) y bloquea los
# scripts de siembra, que se niegan a correr con este valor.
NODE_ENV=production

# Cuantas firmas hacen falta para lacrar un inventario. Default 1, que es el
# proceso real de hoy (lacra el Auditor). Con 2, el cierre necesita dos
# aprobaciones distintas antes de sellar.
# LACRADO_APROBACIONES_REQUERIDAS=1

# ---------------------------------------------------------------------------
# SOLO EN AZURE -- no son del backend, son del servicio
# ---------------------------------------------------------------------------
# WEBSITES_PORT: el puerto que expone el contenedor (el mismo del EXPOSE del
#   Dockerfile). Sin esto el front-end de Azure no sabe a donde mandar el
#   trafico y devuelve 502.
# WEBSITES_ENABLE_APP_SERVICE_STORAGE=false
