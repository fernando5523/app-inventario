// Esquema derivado de mobile/lib/dominio/tipos.ts y mobile/lib/puertos/repositorios.ts.
// No inventa entidades: cada modelo sirve un puerto o un campo ya declarado
// en el dominio del front. Nombres de tabla en snake_case via @@map, como el
// schema del proyecto viejo (monorepo/inventario).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rol derivado del padron de la sucursal (tipos.ts: Colaborador.rol).
/// Nunca lo elige la persona -- lo fija quien la dio de alta en el padron,
/// y el JWT/sesion nunca lo acepta del cliente (ver sesion.service.ts).
/// Jerarquia de alta de cuentas (ver usuarios.service.ts):
///   administrador > auditor > {coordinador, conteo}
/// administrador gestiona todo; auditor puede dar de alta coordinador/conteo
/// de SU sucursal unicamente, nunca otro auditor ni un administrador.
enum Rol {
  administrador
  coordinador
  conteo
  auditor

  @@map("rol")
}

/// Tipo de dato del `valor` (guardado siempre como texto) de una fila de
/// Configuracion -- ver el comentario del modelo para la justificacion de
/// por que es clave-valor y no columnas fijas.
enum TipoConfiguracion {
  entero
  decimal
  texto

  @@map("tipo_configuracion")
}

/// tipos.ts: EstadoHoja. El orden importa y no se puede saltear.
enum EstadoHoja {
  pendiente
  en_proceso @map("en-proceso")
  finalizada

  @@map("estado_hoja")
}

/// tipos.ts: EstadoSync. Estado del dato frente al servidor, aparte del
/// estado del conteo -- una hoja finalizada puede seguir sin sincronizar.
enum EstadoSync {
  local
  sincronizando
  sincronizado
  error

  @@map("estado_sync")
}

/// Ciclo de vida del inventario mensual de una sucursal. El orden importa y
/// no se puede saltear -- cada transicion es una accion distinta con su
/// propio responsable (docs/pantallas.md, Pantallas 4/6/7):
///
///   en_curso       Snapshot tomado, hojas en juego, las rondas de conteo
///                  todavia se pueden tocar. Es el estado en el que el
///                  inventario acepta escrituras de conteo, y tambien en el
///                  que el Coordinador CORRIGE lo que cargaron los
///                  contadores -- con la ronda abierta o ya cerrada.
///   ajuste_auditor La ultima ronda cerro y el AUDITOR TODAVIA NO DECIDIO
///                  que hacer. Es una espera con nombre, no un tramite: al
///                  cerrar la ultima ronda el inventario ya NO pasa solo a
///                  `conteo_cerrado`; se queda aca hasta que el auditor
///                  elija entre las dos salidas que tiene --
///                    - abrir OTRA ronda (una 4ta, una 5ta: las abre el, de
///                      a una, cuando el recuento no termina de cuadrar), y
///                      el inventario vuelve a `en_curso`; o
///                    - iniciar el AJUSTE FINAL, donde el auditor cambia los
///                      valores contados VIENDO el stock del ERP -- lo unico
///                      que el conteo ciego le niega a todos los demas.
///                  El ajuste arranca con un boton suyo y no automaticamente
///                  al cerrar la ronda, y de esa decision del cliente sale la
///                  ventana en la que el Coordinador todavia puede corregir
///                  con la ronda ya cerrada. Desde que se entra aca el
///                  Coordinador queda bloqueado: a partir de este punto los
///                  valores los toca el auditor y nadie mas.
///   conteo_cerrado El ajuste del auditor cerro: las cantidades ya no se
///                  recuentan ni se corrigen, se liquidan.
///   liquidado      La planilla de descuentos esta calculada y confirmada
///                  (Pantalla 6). Falta la firma.
///   lacrado        CERRADO E INMUTABLE (Pantalla 7). Ver LacradoInventario:
///                  a partir de aca nada modifica este inventario, y
///                  cualquier ajuste entra en el periodo siguiente -- es
///                  literalmente lo que pidio el cliente en la reunion.
///   anulado        Salida lateral: se abandono sin llegar a lacrar (por
///                  ejemplo, snapshot equivocado). NO produce historico
///                  contable, pero libera la sucursal para abrir otro --
///                  sin esto, un inventario abierto por error la bloquearia
///                  para siempre por el @@unique([sucursalId, abierto]).
enum EstadoInventario {
  en_curso
  /// Va ENTRE las rondas y el cierre a proposito: el orden de los valores de
  /// un enum de Postgres es el orden en que se declaran, y este es el unico
  /// lugar del sistema donde el ciclo de vida esta escrito en orden.
  ajuste_auditor
  conteo_cerrado
  liquidado
  lacrado
  anulado

  @@map("estado_inventario")
}

/// Los DOS universos de inventario, confirmados por el cliente. No son dos
/// nombres para lo mismo: cuentan cosas distintas.
///
///   mensual  Solo los productos de RESPONSABILIDAD DEL EMPLEADO (6.297 de
///            11.835 en el catalogo real). Los que asume la empresa quedan
///            fuera: no se cuentan.
///   anual    TODO el catalogo activo, empresa incluida ("en el anual ya
///            cuentan todo").
///
/// El anual es un SUPERCONJUNTO del mensual, y de ahi sale la regla de que
/// no pueden estar abiertos a la vez (ver los @@unique de Inventario).
enum TipoInventario {
  mensual
  anual

  @@map("tipo_inventario")
}

/// Clasificacion CRUDA de TRU_InventoryManagerPE (D365), sin colapsar a un
/// booleano: 'None' y "nunca sincronizado" quedan afuera de este enum (el
/// campo que lo usa es nullable) porque ninguno de los dos tiene, hoy,
/// un responsable a quien cargarle nada.
enum ResponsableItem {
  empleado
  empresa

  @@map("responsable_item")
}

/// COMO SE TRATA EL FALTANTE DE ESTE ITEM. Tres vias, y reemplazan al
/// booleano `esEmpresa`: la regla del cliente (Gilmer, reunion 2) ya no es
/// "se descuenta o no", son tres destinos distintos.
///
///   empresa  El faltante lo absorbe la empresa y no se descuenta a nadie.
///            Es exactamente lo que hoy dice `esEmpresa = true`.
///   paquete  Item que VIENE EN PAQUETE. Aca se aplica la regla nueva: si
///            falta MENOS de media unidad de paquete se le descuenta al
///            personal; si falta MAS, sale del descuento al personal y va al
///            cuadro de FALTANTE POR PAQUETE, que se audita aparte y quizas
///            se le descuenta al almacenero.
///   unidad   Item que se compra por unidad (empaque de compra = 1). No hay
///            paquete contra el cual medir media unidad, asi que la regla del
///            umbral NO aplica: su faltante se descuenta al personal como
///            siempre. Son 457 de los primeros 2.000 items del catalogo real
///            -- no es un caso de borde.
///
/// El eje es OTRO que el de `ResponsableItem`: aquel dice QUIEN responde
/// segun el ERP (empleado/empresa), este dice COMO se trata el faltante. Se
/// cruzan en `empresa` y nada mas.
/// Que parte de la navegacion configura una fila: las tarjetas del home o la
/// barra de abajo. Van en la MISMA tabla porque el Administrador las maneja
/// igual (prender, apagar, reordenar) y separarlas serian dos tablas
/// identicas con dos endpoints identicos.
enum TipoNavegacion {
  acceso
  tab

  @@map("tipo_navegacion")
}

enum ClaseItem {
  empresa
  paquete
  unidad

  @@map("clase_item")
}

// ---------------------------------------------------------------------------
// Sesion / padron
// ---------------------------------------------------------------------------

model Sucursal {
  id            Int           @id @default(autoincrement())
  nombre        String
  /// Deshabilitar sin borrar -- mismo criterio que Colaborador.activo: una
  /// tienda cerrada sigue siendo dueña de inventarios historicos reales.
  activa        Boolean       @default(true)
  direccion     String?
  telefono      String?

  /// Almacen de Dynamics del que esta tienda trae su stock (`WarehouseId`,
  /// ej. "MD11_CENT"). Decision del cliente: "al crear el sitio, se debe
  /// asociar el almacen" -- es un ATRIBUTO de la sucursal, no una tabla de
  /// traduccion aparte que alguien tiene que mantener sincronizada.
  ///
  /// NULLABLE, y la razon importa: null significa "todavia no sabemos cual
  /// es", que es la verdad para las tiendas ya cargadas. La alternativa era
  /// hacerlo obligatorio y rellenar las existentes con un placeholder -- y
  /// un almacen inventado es PEOR que ninguno: trae el stock de otra tienda,
  /// la auditoria compara contra numeros que parecen validos y nadie se
  /// entera hasta que no cuadra a fin de mes. Es el mismo criterio que
  /// CatalogoItem.stockErp: "no se" nunca se escribe como un valor.
  ///
  /// Sin almacen NO se puede traer snapshot -- eso se rechaza en el momento
  /// de traerlo, con un mensaje que dice que falta configurarlo (ver
  /// d365-catalogo.service.ts). Dar de alta la tienda sigue siendo posible:
  /// bloquear el alta porque alguien todavia no averiguo el codigo en
  /// Dynamics seria trabar el padron por un dato que se agrega despues.
  almacenId     String?       @map("almacen_id")
  /// Nombre legible del almacen, copiado de Dynamics al elegirlo. Se guarda
  /// para no tener que ir al ERP cada vez que se muestra la tienda, y para
  /// que quede constancia de que se eligio -- misma razon que
  /// DiferenciaItem.descripcion.
  almacenNombre String?       @map("almacen_nombre")

  colaboradores Colaborador[]
  inventarios   Inventario[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sucursales")
}

model Colaborador {
  id         Int      @id @default(autoincrement())
  nombre     String
  dni        String
  /// Derivado del padron (ver comentario del enum Rol), nunca elegido por la persona.
  rol        Rol
  /// PIN de 6 digitos, SIEMPRE hasheado (argon2). Nunca se guarda en claro.
  pinHash    String    @map("pin_hash")
  /// NULL unicamente para rol=administrador: es del sistema, no de una
  /// tienda, y gestiona las 4 sucursales por rol, no colgando de una fila.
  /// Para los otros 3 roles sigue siendo obligatorio -- se exige en la capa
  /// de aplicacion (usuarios.schema.ts), no con un CHECK de Postgres.
  /// OJO al leer @@unique([sucursalId, dni]) mas abajo: Postgres trata cada
  /// NULL como distinto, asi que esa unicidad NO cubre DNI duplicado entre
  /// administradores -- aceptable hoy porque solo hay un administrador
  /// sembrado y los crea otro administrador (accion infrecuente y auditada).
  sucursalId Int?      @map("sucursal_id")
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  /// Deshabilitar en vez de borrar -- en un sistema que se audita, una
  /// cuenta borrada es un conteo huerfano (queda sin autor). ingresar()
  /// rechaza el login si esto es false (ver sesion.service.ts).
  activo     Boolean  @default(true)

  /// Trazabilidad de alta (ver RegistroAuditoria para el detalle de la
  /// accion): quien creo esta cuenta y, por createdAt, cuando. Null =
  /// sembrada por el seed inicial, no dada de alta por la API.
  creadoPorId    Int?          @map("creado_por_id")
  creadoPor      Colaborador?  @relation("CreadoPor", fields: [creadoPorId], references: [id])
  cuentasCreadas Colaborador[] @relation("CreadoPor")

  asignadoComoPrincipal   HojaConteo[]        @relation("AsignadoA")
  asignadoComoSecundario  HojaConteo[]        @relation("AsignadoA2")
  sesiones                SesionToken[]
  accionesDeAuditoria     RegistroAuditoria[] @relation("ActorAuditoria")

  /// Rastro en el historico de inventarios. Es OTRA razon por la que las
  /// cuentas se deshabilitan y nunca se borran (ver Colaborador.activo):
  /// un lacrado sin identidad de quien firmo no sirve como control.
  inventariosCerrados     Inventario[]             @relation("InventarioCerradoPor")
  lacradosEjecutados      LacradoInventario[]      @relation("LacradoPor")
  registrosEnErp          RegistroErpInventario[]  @relation("RegistradoEnErpPor")
  aprobacionesDeCierre    AprobacionCierre[]       @relation("AprobadorCierre")
  liquidaciones           LiquidacionColaborador[] @relation("ColaboradorLiquidado")
  configsDynamics         ConfigDynamics[]         @relation("ConfigDynamicsActualizadaPor")
  /// Ajustes del mes que cargo -- plata que se decide NO descontarle al
  /// personal, asi que lleva firma (ver ResultadoInventario.ajustesPorId).
  ajustesRegistrados      ResultadoInventario[]    @relation("AjustesRegistrados")
  /// Liquidacion v2 -- firmas de decisiones del Auditor que mueven plata o
  /// cambian la clasificacion de un producto. Ver cada modelo.
  clasificacionesProducto ClasificacionProducto[]      @relation("ClasificadoPor")
  importacionesAjustes    ImportacionAjustesDynamics[] @relation("ImportadoPor")
  lineasAjusteExcluidas   LineaAjusteDynamics[]        @relation("ExcluidaPor")
  /// Asistencia: los dias en que se le marco la entrada, y -- si es
  /// Coordinador -- las marcas que cargo. Son DOS relaciones distintas a la
  /// misma tabla y por eso van nombradas; confundirlas le atribuiria a
  /// alguien una asistencia que solo registro.
  asistencias             AsistenciaInventario[]       @relation("ColaboradorMarcado")
  asistenciasRegistradas  AsistenciaInventario[]       @relation("AsistenciaRegistradaPor")
  /// Justificaciones: las faltas que le perdonaron y -- si es Auditor -- las
  /// que perdono. Dos relaciones nombradas a la misma tabla, por lo mismo que
  /// arriba: confundirlas le perdonaria una falta a quien solo firmo el
  /// perdon de otro.
  /// Cambios de navegacion que firmo (solo el Administrador toca esto).
  navegacionActualizada   ConfiguracionNavegacion[]    @relation("NavegacionActualizadaPor")
  faltasJustificadas      JustificacionAsistencia[]    @relation("ColaboradorJustificado")
  justificacionesFirmadas JustificacionAsistencia[]    @relation("JustificacionRegistradaPor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sucursalId, dni])
  @@map("colaboradores")
}

/// Configuracion global del sistema (no por sucursal): clave-valor tipado
/// en vez de columnas fijas. Se elige asi porque ya hay una pregunta
/// abierta del propio negocio sobre sumar mas ajustes a futuro (ver
/// docs/pantallas.md, pregunta 1) -- una tabla de columnas fijas exige una
/// migracion por cada config nueva; clave-valor no. El costo es que la
/// forma de "valor" (int vs decimal vs texto) se valida en la capa de
/// aplicacion (ver modules/config/config.schema.ts) segun `tipo`, no en el
/// tipo de columna de Postgres -- aceptable con 3 valores conocidos hoy.
/// El umbral de "media unidad de paquete" (config UMBRAL_MEDIA_UNIDAD_PAQUETE)
/// es el default sugerido, no una regla dura: la propia reunion aclara que
/// el auditor lo ajusta caso por caso (ver docs/pantallas.md, pregunta 1).
model Configuracion {
  id          Int               @id @default(autoincrement())
  clave       String            @unique
  valor       String
  tipo        TipoConfiguracion
  descripcion String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuraciones")
}

/// Rastro de acciones de administracion (alta/baja/reset de PIN de
/// cuentas, altas o cambios de tienda, cambios de configuracion): si se
/// puede dar de alta gente que despues cuenta inventario, tiene que quedar
/// registro de quien lo hizo y cuando. `entidad` + `entidadId` apuntan a
/// filas de distintas tablas (Colaborador, Sucursal, Configuracion,
/// Conteo) -- Prisma no modela relaciones polimorficas, asi que queda como
/// puntero libre en vez de una FK; cada *.service.ts arma el valor correcto,
/// nunca se acepta del cliente.
///
/// ---------------------------------------------------------------------------
/// YA NO ES SOLO ADMINISTRACION, Y ESO LE SUBE EL PESO A ESTA TABLA
/// ---------------------------------------------------------------------------
/// Desde las correcciones de conteo, aca tambien entran acciones
/// OPERATIVAS: `conteo.corregido` (el Coordinador arregla lo que cargo un
/// contador, sin ver el stock) y `conteo.ajustado` (el Auditor cambia el
/// valor final, viendo el stock). Las dos con `entidad: 'conteo'` y
/// `entidadId` = el id del Conteo.
///
/// Y la consecuencia que hay que entender antes de tocar nada aca: la
/// correccion REEMPLAZA el valor contado -- decision del cliente --, asi que
/// el numero original NO SOBREVIVE EN NINGUNA OTRA TABLA. `Conteo` queda con
/// el valor corregido y el lacrado sella ese. Lo que el contador conto de
/// verdad existe unicamente en el `detalle` de la fila de auditoria.
///
/// O sea que esta tabla dejo de ser un registro "por las dudas" y paso a ser
/// la unica prueba de un numero que descuenta plata del sueldo de alguien. De
/// ahi salen tres cosas que no hay que hacer: no purgarla sin pensarlo (hoy
/// no hay purga, y no la agregues sin resolver esto primero), no borrar sus
/// filas cuando se borra un conteo, y no aflojar el `motivo`.
///
/// El `motivo` de cada correccion es OBLIGATORIO y viaja dentro de `detalle`
/// -- Postgres no lo exige, lo exige la capa de aplicacion, mismo criterio
/// que el `sucursalId` obligatorio de Colaborador. Un cambio sin motivo es un
/// descuento que nadie puede explicar seis meses despues.
///
/// El @@index([entidad, entidadId]) de abajo ya cubre la consulta nueva
/// ("todas las correcciones de ESTE conteo"): no hace falta indice extra.
model RegistroAuditoria {
  id        Int         @id @default(autoincrement())
  actorId   Int         @map("actor_id")
  actor     Colaborador @relation("ActorAuditoria", fields: [actorId], references: [id])
  /// "colaborador.creado" | "colaborador.habilitado" | "colaborador.deshabilitado"
  /// | "colaborador.pin_reseteado" | "sucursal.creada" | "sucursal.actualizada"
  /// | "configuracion.actualizada" | "conteo.corregido" | "conteo.ajustado"
  /// -- string libre, no enum: quien agrega un modulo de administracion nuevo
  /// no deberia migrar este enum para loguear. Por eso tampoco hay un CHECK
  /// en la base que exija `motivo` segun la accion: ataria esta tabla a dos
  /// nombres de accion concretos y se perderia justamente eso.
  accion    String
  entidad   String
  entidadId Int      @map("entidad_id")
  /// Nunca el PIN en claro (ver comentario de pinHash arriba): un reseteo
  /// de PIN audita QUE paso y A QUIEN, jamas el valor nuevo.
  ///
  /// En una correccion de conteo lleva
  ///   { productoId, codigo, ronda, valorAnterior, valorNuevo, motivo }
  /// y `valorAnterior`/`valorNuevo` NO son un numero: un conteo son sus
  /// lineas por empaque MAS las sueltas (ver Conteo y LineaConteo). Guardar
  /// solo el total en unidades perderia con que empaques se conto, que es la
  /// mitad de lo que hay que poder reconstruir. `ronda` sale de
  /// `HojaConteo.numeroConteo`: Conteo no la guarda, cuelga de la hoja.
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entidad, entidadId])
  @@map("registro_auditoria")
}

/// Token de sesion emitido por RepositorioSesion.ingresar(). tipos.ts#Sesion
/// no tiene id porque es un DTO de respuesta, no una entidad -- esta tabla es
/// lo que auth.middleware.ts necesita para validar el token en cada request.
model SesionToken {
  id            Int         @id @default(autoincrement())
  token         String      @unique
  colaboradorId Int         @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  expiraEn      DateTime    @map("expira_en")
  createdAt     DateTime    @default(now()) @map("created_at")

  /// `token` ya tiene su @unique (es por donde entra auth.middleware.ts en
  /// cada request). Este es para el otro acceso, que no tenia ninguno:
  /// `deleteMany({ where: { colaboradorId } })` -- revocar las sesiones de una
  /// persona al cambiarle el PIN (sesion.service.ts#cambiarPin) o al
  /// deshabilitarla (usuarios.service.ts#eliminar).
  ///
  /// Hoy la tabla es chica, pero CRECE SIN PURGA: no hay nada que borre los
  /// tokens vencidos, asi que acumula una fila por login de todo el personal
  /// de las 11 tiendas. Ver backend/docs/rendimiento-db.md (H10) -- la purga
  /// queda anotada ahi, es un tema aparte.
  @@index([colaboradorId])
  @@map("sesiones_token")
}

// ---------------------------------------------------------------------------
// Inventario / hojas
// ---------------------------------------------------------------------------

/// Referenciado por HojaConteo.inventarioId en tipos.ts. Agrupa las hojas de
/// una corrida de conteo en una sucursal, guarda el snapshot de Dynamics
/// (RepositorioInventario.traerSnapshot) y es la UNIDAD DEL HISTORICO: un
/// inventario = el cierre mensual de una sucursal (docs/pantallas.md,
/// Pantallas 4/6/7). Todo lo que el negocio llama "el inventario de agosto
/// de Luzuriaga" es una fila de esta tabla y lo que le cuelga.
///
/// CICLO DE VIDA (ver EstadoInventario): en_curso -> conteo_cerrado ->
/// liquidado -> lacrado. `anulado` es la unica salida lateral y existe para
/// que un inventario abierto por error no deje la sucursal bloqueada para
/// siempre (ver el @@unique de `abierto` mas abajo).
model Inventario {
  id               Int            @id @default(autoincrement())
  sucursalId       Int            @map("sucursal_id")
  sucursal         Sucursal       @relation(fields: [sucursalId], references: [id])

  /// Ver EstadoInventario. Nace `en_curso` para no romper a quien crea un
  /// inventario sin declararlo (d365-catalogo.service.ts#crearSnapshot): un
  /// snapshot recien tomado ES un inventario en curso, no hay otro estado
  /// posible al nacer.
  estado           EstadoInventario @default(en_curso)

  /// Que universo se cuenta -- ver TipoInventario. Default `mensual` a
  /// proposito: es el que se hace todos los meses. El anual es la excepcion
  /// y hay que pedirlo explicito; que alguien cuente 11.835 items creyendo
  /// que cuenta 6.297 es una jornada entera perdida.
  tipo             TipoInventario   @default(mensual)

  /// Periodo mensual al que pertenece este inventario ("Agosto 2026" en la
  /// maqueta). Se guarda como anio+mes y NO como un DateTime porque el
  /// periodo es un mes calendario entero, no un instante: guardarlo como
  /// fecha obliga a elegir un dia arbitrario y a pelear con la zona horaria
  /// cada vez que alguien pregunta "de que mes es esto".
  ///
  /// El default lo calcula Postgres (mes en curso al insertar) por dos
  /// razones: es el valor correcto del negocio -- el snapshot se toma
  /// cuando arranca el inventario del mes -- y deja que el snapshot de
  /// d365 siga creando filas sin declarar periodo. Cuando exista el modulo
  /// de inventario real, ese modulo lo pasa explicito.
  periodoAnio      Int            @default(dbgenerated("EXTRACT(YEAR FROM now())::int")) @map("periodo_anio")
  periodoMes       Int            @default(dbgenerated("EXTRACT(MONTH FROM now())::int")) @map("periodo_mes")

  /// 20 | 30 | 50 -- el tamano de hoja es CONFIGURABLE y cambia entre
  /// inventarios (docs/pantallas.md, Decision del Cliente 4). Se copia aca
  /// desde Configuracion.TAMANO_HOJA_DEFECTO al abrir el inventario, y no
  /// se lee de la config al consultarlo: dentro de seis meses la config va
  /// a valer otra cosa y el historico tiene que seguir diciendo con cuantos
  /// items por hoja se conto ESE mes.
  tamanoHoja       Int            @default(50) @map("tamano_hoja")

  /// EL UMBRAL DE "MEDIA UNIDAD DE PAQUETE", congelado al abrir el inventario.
  ///
  /// Es la perilla que ya existia y no movia nada: la configuracion
  /// `UMBRAL_MEDIA_UNIDAD_PAQUETE` se valida (config.validadores.ts), se
  /// guarda y se edita desde la pantalla del Administrador, pero NINGUN
  /// calculo la leia. Estaba la perilla y no el mecanismo. Esta columna es el
  /// cable: el calculo del faltante por paquete lee de acá, no de la config
  /// viva.
  ///
  /// SE COPIA, no se lee en vivo, por lo mismo que `tamanoHoja`: dentro de
  /// seis meses la config va a valer otra cosa y el historico tiene que poder
  /// decir con que umbral se decidio cada descuento. Recalcular una
  /// liquidacion con la perilla de hoy le cambiaria el sueldo a alguien de
  /// agosto.
  ///
  /// 0.5 = "media unidad", que es como lo dijo el cliente. Es configurable
  /// porque el propio Auditor aclaro que lo ajusta caso por caso
  /// (docs/pantallas.md, pregunta 1).
  ///
  /// Decimal y no Float, mismo criterio que toda la plata del schema. Con
  /// (4,3) entra cualquier fraccion entre 0.001 y 0.999, que es el rango que
  /// el validador ya exige (mayor que 0, menor que 1).
  umbralMediaUnidadPaquete Decimal @default(0.5) @map("umbral_media_unidad_paquete") @db.Decimal(4, 3)

  snapshotItems    Int?           @map("snapshot_items")
  snapshotTomadoEn DateTime?      @map("snapshot_tomado_en")

  /// Apertura y cierre del CONTEO (no del lacrado: eso vive en
  /// LacradoInventario.lacradoEn). `cerradoEn`/`cerradoPor` se llenan cuando
  /// las cantidades quedan fijas y pasan a liquidacion -- o sea al cerrar el
  /// AJUSTE DEL AUDITOR, que es el ultimo paso del conteo. No al cerrar la
  /// ultima ronda: ahi el inventario queda en `ajuste_auditor` esperando que
  /// el auditor decida, y todavia puede abrirse otra ronda.
  /// LA ULTIMA RONDA QUE SE CERRO. `null` = ninguna todavia.
  ///
  /// ES UNA MARCA PROPIA, y existe porque antes no habia ninguna: el cierre de
  /// una ronda se deducia de que EXISTIERA la ronda siguiente. Eso funciona
  /// mientras queden diferencias -- cerrar crea la ronda N+1 y esa existencia
  /// es la huella -- pero cuando TODO CUADRA no se crea ninguna ronda y el
  /// cierre no dejaba rastro. Bug real (2026-09-22, inventario 8073 de
  /// Luzuriaga, 980 items y los 980 cuadrando): el Coordinador cerraba, veia
  /// el dialogo de exito, la pantalla seguia diciendo "Paso 1 - En curso" y el
  /// sistema aceptaba cerrar de nuevo. Quedo trabado, y el Auditor sin recibir
  /// nada.
  ///
  /// NO DICE QUE EL CONTEO TERMINO. Dice que ESA RONDA cerro, nada mas. El
  /// inventario sigue `en_curso` esperando al Auditor, que decide si abre otra
  /// pasada o arranca el ajuste final -- y en esa ventana el Coordinador
  /// todavia corrige lo que cargaron los contadores. Confundir las dos cosas
  /// cierra esa ventana (ver la rama `!siguiente.puede` de rondas.service.ts y
  /// `ajuste.permisos.ts`).
  ///
  /// DISTINTA de `cerradoEn`/`cerradoPorId`, que son del cierre del INVENTARIO
  /// (el paso a `conteo_cerrado`, que hace `cerrarAjuste`). Una ronda cerrada
  /// no cierra el inventario.
  ultimaRondaCerrada Int?         @map("ultima_ronda_cerrada")

  abiertoEn        DateTime       @default(now()) @map("abierto_en")
  cerradoEn        DateTime?      @map("cerrado_en")
  cerradoPorId     Int?           @map("cerrado_por_id")
  cerradoPor       Colaborador?   @relation("InventarioCerradoPor", fields: [cerradoPorId], references: [id])

  /// EL CANDADO DE "UN SOLO INVENTARIO ABIERTO POR SUCURSAL", en la base y
  /// no en un `if` que alguien puede olvidar.
  ///
  /// Solo tiene DOS valores legales: `true` (abierto) y NULL (cerrado).
  /// Nunca `false`. Junto con @@unique([sucursalId, abierto]) alcanza,
  /// porque Postgres considera cada NULL distinto de todos los demas en un
  /// indice unico: dos filas (sucursal 1, true) chocan, pero N filas
  /// (sucursal 1, NULL) conviven sin problema. Es el indice unico parcial
  /// clasico, expresado con lo que Prisma sabe declarar.
  ///
  /// Por eso CERRAR un inventario es `abierto: null`, jamas
  /// `abierto: false` -- eso volveria a bloquear la sucursal. Lo escribe
  /// siempre el service, nunca el cliente.
  ///
  /// "Cerrar" es cuando el CONTEO cierra (`estado -> conteo_cerrado`,
  /// rondas.service.ts), NO cuando se lacra. Bug real (2026-09-10): estaba
  /// solo en historial.service.ts#lacrar, asi que una tienda con el mes
  /// contado pero sin la firma del auditor (normal, tarda dias) quedaba sin
  /// poder arrancar el mes siguiente -- el idempotente de
  /// d365-catalogo.service.ts#crearSnapshot (que SI debe mirar `estado`, no
  /// este campo) devolvia el snapshot de ese inventario ya cerrado.
  /// `lacrar()` tambien lo pone en null, por las dudas de que este paso se
  /// saltee alguna vez -- redundante y a proposito, no un lugar de mas.
  abierto          Boolean?       @default(true)

  hojas            HojaConteo[]
  catalogo         CatalogoItem[]
  /// 1:1 -- un inventario se lacra UNA sola vez y no se re-lacra.
  lacrado          LacradoInventario?
  resultado        ResultadoInventario?
  diferencias      DiferenciaItem[]
  aprobaciones     AprobacionCierre[]
  liquidaciones    LiquidacionColaborador[]
  /// Excel de ajustes de Dynamics importados para este inventario. Pueden
  /// ser varios (re-importar no borra), pero a lo sumo UNO vigente -- ver
  /// ImportacionAjustesDynamics.vigente.
  importacionesAjustes ImportacionAjustesDynamics[]
  /// Las marcas de entrada del personal. Pueden existir ANTES que la primera
  /// hoja y que el primer conteo: se pasa lista cuando la gente llega.
  asistencias          AsistenciaInventario[]
  /// Las faltas que el Auditor perdono. Misma salvedad que `asistencias`:
  /// pueden existir sin una sola hoja ni un solo conteo.
  justificaciones      JustificacionAsistencia[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// UN inventario de cada TIPO por sucursal y periodo. `tipo` entra en esta
  /// restriccion y NO en la de abajo, y la asimetria es deliberada:
  ///
  /// El anual de 2026 y el mensual de diciembre 2026 son dos cierres
  /// distintos del mismo periodo, y los dos tienen que poder existir en el
  /// historico. Sin `tipo` aca, el segundo chocaria contra el primero y no
  /// se podria archivar el anual.
  @@unique([sucursalId, periodoAnio, periodoMes, tipo])

  /// UN SOLO INVENTARIO ABIERTO POR SUCURSAL, sin importar el tipo. Aca
  /// `tipo` NO entra, y esa es la decision:
  ///
  /// El anual es un superconjunto del mensual (11.835 items contra 6.297).
  /// Si los dos pudieran estar abiertos a la vez, los mismos productos se
  /// estarian contando en dos inventarios simultaneos, con dos conteos que
  /// pueden diferir; y si los dos llegan a liquidarse, al empleado se le
  /// descuenta DOS VECES el mismo faltante. Ademas, en la practica: son
  /// once personas en la tienda, no pueden hacer dos inventarios a la vez.
  ///
  /// Asi que la restriccion no es "de mas" -- dice exactamente lo que el
  /// negocio necesita: primero se cierra uno, despues se abre el otro.
  @@unique([sucursalId, abierto])
  @@index([sucursalId, estado])
  @@index([sucursalId, tipo])
  @@map("inventarios")
}

/// Catalogo crudo del snapshot de Dynamics (modules/d365/), ANTES de
/// partirse en hojas -- por eso cuelga de Inventario y no de HojaConteo
/// como Producto. Cuando exista un modulo de hojas real en este backend,
/// "crear hojas" (paso 2 del Coordinador) lee de aca para poblar cada
/// HojaConteo.productos; hasta entonces es solo el destino del snapshot.
/// Misma forma que Producto (mismo Empaque relacionado, ver ese
/// comentario) para no tener dos formas distintas de guardar "un producto
/// con sus empaques" en el mismo schema -- si algun dia difieren, la mitad
/// del dato se pierde justo al copiar de aca a Producto.
model CatalogoItem {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  /// ItemNumber de Dynamics.
  codigo       String
  /// codigo de barras de la unidad SUELTA.
  codigoBarras String @map("codigo_barras")
  descripcion  String

  /// Categoria de "Catalogo Ventas" en Dynamics (ProductCategoryAssignments):
  /// "FIDEOS Y PASTAS", "GALLETAS", "DETERGENTES EN POLVO".
  ///
  /// NO es decoracion: es el ORDEN en que se arman las hojas de conteo. Sin
  /// esto, las hojas salen ordenadas por codigo de item -- y el codigo de
  /// Dynamics no sigue el recorrido fisico de la tienda, asi que el operario
  /// arranca con un shampoo, sigue con una gaseosa y despues una lata de
  /// atun, cruzando el local en cada renglon. Agrupando por categoria barre
  /// un sector y pasa al siguiente. Mismo criterio que usa el proyecto de
  /// reportes del cliente (app_inventarioautomatico).
  ///
  /// Nullable porque un producto puede no tener asignacion en el ERP: esos
  /// van al final, juntos, en vez de quedar afuera del inventario.
  categoria String? @map("categoria")

  /// SIEMPRE al menos uno (ver Producto.empaques). D365 (Market Trujillo)
  /// puede traer mas de un empaque alterno para el mismo producto en
  /// ProductSpecificUnitOfMeasureConversions -- antes se descartaban todos
  /// menos el de mayor factor, ahora se guardan todos.
  empaques EmpaqueCatalogo[]

  // -------------------------------------------------------------------------
  // Datos del ERP que alimentan la AUDITORIA (tipos.ts#ItemAuditoria).
  //
  // Viven aca y NO en `Producto`, y esa distincion es el conteo ciego
  // entero: `Producto` es lo que ve la persona que cuenta -- por eso no
  // tiene stock ni precio, y no puede tenerlos nunca. `CatalogoItem` es el
  // snapshot crudo de Dynamics, que solo consumen el backend y la pantalla
  // del Auditor -- durante su AJUSTE FINAL (estado `ajuste_auditor`) y
  // despues de cerrado el conteo. Ver el ajuste como la excepcion que es: el
  // auditor cambia valores VIENDO el stock, y es el unico que puede. El
  // Coordinador tambien corrige lo que cargaron los contadores, pero a ciegas
  // -- sin estas columnas, ni en la pantalla ni en el DTO.
  //
  // Si estas tres columnas estuvieran en `Producto`, cualquier endpoint de
  // conteo podria filtrarlas a un contador sin que nadie lo note, y los 3
  // conteos cruzados dejarian de servir para lo unico que existen.
  // -------------------------------------------------------------------------

  /// Stock que dice el ERP al momento del snapshot. Es el numero CONTRA el
  /// que se compara -- nunca se recalcula ni se actualiza despues: el
  /// inventario audita contra la foto que se saco al abrir el mes, no
  /// contra lo que Dynamics diga hoy.
  /// Nullable porque el snapshot puede venir de una entidad de D365 que no
  /// expone stock: la matriz se arma igual, marcando el item como no
  /// auditable, en vez de inventar un 0 que se leeria como "falta todo".
  stockErp Int? @map("stock_erp")

  /// Precio de VENTA, no de compra: asi lo definio el cliente en la reunion
  /// para valorizar diferencias (ver mobile/lib/dominio/auditoria.ts).
  /// Decimal, nunca Float -- misma razon que en ResultadoInventario.
  precioVenta Decimal? @map("precio_venta") @db.Decimal(12, 4)

  /// true = la categoria la asume la EMPRESA por orden de gerencia (las
  /// cervezas del ejemplo del cliente, por seguimiento de robo): el faltante
  /// existe y se reporta, pero no se descuenta a nomina.
  /// Es un dato configurado caso por caso en Dynamics, no algo que el
  /// dominio pueda calcular solo (tipos.ts#ItemAuditoria.esEmpresa) -- por
  /// eso es una columna del snapshot y no una regla en codigo.
  esEmpresa Boolean @default(false) @map("es_empresa")

  /// Clasificacion COMPLETA de TRU_InventoryManagerPE (D365), sin colapsar a
  /// `esEmpresa`: esa columna no distingue 'Employee' de 'None', y el export
  /// de diferencias (pedido del cliente, 2026-09) necesita justamente esa
  /// distincion para EXCLUIR del reporte tanto lo de la empresa como lo
  /// desconocido -- solo entra 'empleado'.
  /// null = D365 dijo 'None', o el item nunca sincronizo esta entidad.
  /// Aditiva: `esEmpresa` sigue existiendo tal cual, no se toca.
  responsable ResponsableItem? @map("responsable")

  /// EL EMPAQUE DE COMPRA, en unidades sueltas. 12 = la caja trae 12.
  ///
  /// ES EL DENOMINADOR DE LA REGLA DEL UMBRAL, y tiene que ser el de COMPRA,
  /// no el de venta. Gilmer lo dijo tres veces en la reunion 2 -- "lo que
  /// estoy hablando aca es el empaque de compra, que no se base al empaque de
  /// venta" -- y lo aterrizo en el ERP: "eso depende de lo que hayan marcado
  /// en Dynamics, si ellos lo tienen marcado 540, te va a decir 540". Su
  /// ejemplo es un chocolate con empaque de compra 540 y display de venta 20:
  /// con esa diferencia, 10 unidades faltantes son media caja de venta (se
  /// descuenta) o 1/54 de la de compra (no se descuenta). No es un matiz.
  ///
  /// DE DONDE SALE, medido contra el tenant real (scripts/explorar-empaque-compra.ts):
  /// `ReleasedProductsV2.PurchaseUnitSymbol` da el NOMBRE de la unidad de
  /// compra ("Emp.12"), y `ProductSpecificUnitOfMeasureConversions` da el
  /// factor de ESE simbolo A LA UNIDAD BASE. Lo segundo importa: un mismo
  /// simbolo tiene varias filas de conversion (Emp.48->Emp.12=4 y
  /// Emp.48->U=48), y la que sirve es la que va a la unidad suelta, porque en
  /// unidades sueltas se cuenta.
  ///
  /// NO ES el empaque que guarda `EmpaqueCatalogo`: esos son los de conteo en
  /// gondola (todas las conversiones, de mayor a menor). Medido sobre 2.000
  /// items reales, en 328 el empaque de compra DIFIERE del mayor de esa lista
  /// -- item 110628 compra 24 contra 36, item 100000 compra 6 contra 12. Usar
  /// aquel en vez de este cambia a quien se le descuenta el faltante.
  ///
  /// NULL = no se pudo resolver (ni conversion a la unidad base, ni numero en
  /// el nombre del simbolo). NULL no es 1: "no se sabe el tamano del paquete"
  /// es distinto de "se compra por unidad", y con NULL la regla del umbral no
  /// se puede aplicar -- el calculo tiene que decidir que hace, no asumir.
  empaqueCompra       Int?    @map("empaque_compra")
  /// El simbolo tal cual lo tiene Dynamics ("Emp.12", "CJ"). Viaja al lado del
  /// numero para poder auditar de donde salio: si manana alguien discute un
  /// descuento, la respuesta es "el ERP dice Emp.12", no "el sistema calculo 12".
  empaqueCompraSimbolo String? @map("empaque_compra_simbolo")

  /// COMO SE TRATA EL FALTANTE de este item -- ver el enum `ClaseItem`.
  ///
  /// Se congela con el snapshot, igual que `esEmpresa` y por la misma razon:
  /// si manana cambia la clasificacion en Dynamics, el inventario de agosto
  /// tiene que seguir diciendo con que regla se liquido.
  ///
  /// Se DERIVA al tomar el snapshot: `empresa` si el ERP dice que responde la
  /// empresa; si no, `paquete` cuando el empaque de compra es mayor que 1 y
  /// `unidad` cuando es exactamente 1. Con el empaque en NULL queda `unidad`,
  /// que es el tratamiento de siempre -- no se inventa un paquete que nadie
  /// midio.
  ///
  /// RELACION CON `esEmpresa`, que sigue existiendo: `clase == empresa` es
  /// exactamente `esEmpresa == true`, y se escriben juntas. La columna vieja
  /// queda porque la leen la auditoria, la liquidacion y el SELLO del lacrado;
  /// sacarla es parte del cambio del calculo, no de este. Mientras las dos
  /// existan NO PUEDEN DISCREPAR: las escribe el mismo snapshot, de la misma
  /// fuente, en la misma fila.
  clase ClaseItem @default(unidad)

  /// SIN USO -- nadie la escribe ni la lee. Se diseno para copiar aca la
  /// excepcion del Auditor al traer el snapshot, pero despues se decidio
  /// evaluar la clasificacion AL LIQUIDAR, leyendo ClasificacionProducto en
  /// vivo (liquidacion.reclasificacion.ts). Queda en NULL en todas las filas.
  ///
  /// No se borra porque sacarla es una migracion. No la llenes sin revisar
  /// esa decision: una copia congelada en el snapshot contradice justamente
  /// que una reclasificacion posterior al cierre aplique igual.
  esEmpresaManual Boolean? @map("es_empresa_manual")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([inventarioId, codigo])
  @@index([inventarioId, codigoBarras])
  @@map("catalogo_items")
}

/// Un empaque del catalogo crudo de Dynamics -- ver el comentario largo de
/// Empaque (abajo, el de Producto) para el criterio de diseno completo:
/// mismo motivo (value object sin id en el dominio, tabla propia solo
/// porque Postgres necesita filas para una lista), mismo nombre de campos.
model EmpaqueCatalogo {
  id             Int          @id @default(autoincrement())
  catalogoItemId Int          @map("catalogo_item_id")
  catalogoItem   CatalogoItem @relation(fields: [catalogoItemId], references: [id], onDelete: Cascade)

  nombre String
  factor Int
  /// Casi siempre vacio -- ver el comentario largo en Empaque.codigoBarras.
  codigoBarras String? @map("codigo_barras")
  /// Orden de oferta (0 = primero). Ver Empaque.orden.
  orden Int @default(0)

  @@unique([catalogoItemId, nombre])
  @@map("empaques_catalogo")
}

/// tipos.ts#HojaConteo. `numeroConteo` es la ronda, y NO tiene tope: el
/// schema viejo solo tenia conteo1/conteo2 como columnas fijas; este dominio
/// arranca con TRES rondas (`CANTIDAD_CONTEOS_CICLO`, configurable) y el
/// AUDITOR puede abrir mas -- una 4ta, una 5ta -- de a una, cuando el
/// recuento no termina de cuadrar. Que sea una ronda mas y no una columna es
/// justamente lo que hace que eso no cueste una migracion,
/// asi que se modela como una ronda mas -- no como columnas hardcodeadas --
/// para no repetir el problema del schema viejo si algun dia hay una 4ta.
model HojaConteo {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])
  numeroConteo Int        @map("numero_conteo")
  /// "002" -- numero de hoja dentro de la ronda, no id.
  numero       String
  zona         String
  gondola      String
  /// CUANTOS ITEMS TIENE ESTA HOJA -- no el 20/30/50 que se eligio al armar
  /// el lote. La ultima hoja casi siempre queda parcial (1.236 items en
  /// hojas de 50 dan 24 de 50 y una de 36), y guardar 50 ahi hacia que la
  /// pantalla de conteo dijera "36 / 50 Productos" con todo contado.
  ///
  /// El tamaño PEDIDO vive en Inventario.tamanoHoja, que es donde sirve
  /// para el historico.
  tamano       Int
  estado       EstadoHoja @default(pendiente)
  sync         EstadoSync @default(local)

  /// Hasta 2 asignados por hoja (tipos.ts: HojaConteo.asignados).
  asignadoAId  Int?         @map("asignado_a_id")
  asignadoA    Colaborador? @relation("AsignadoA", fields: [asignadoAId], references: [id])
  asignadoA2Id Int?         @map("asignado_a_2_id")
  asignadoA2   Colaborador? @relation("AsignadoA2", fields: [asignadoA2Id], references: [id])

  productos Producto[]
  conteos   Conteo[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inventarioId, numeroConteo, numero])
  /// "MIS hojas" (hojas.service.ts#listar, alcance='mias') filtra por estas
  /// dos columnas con un OR, y ninguna estaba en ningun indice: era un
  /// recorrido completo de la tabla cada vez que un Contador abre su pantalla.
  /// Con ~24.800 hojas al año (11 tiendas x 12 meses x ~188 hojas) eso deja de
  /// ser gratis.
  ///
  /// DOS indices y no uno compuesto: es un OR entre columnas distintas, no un
  /// AND. Un indice (asignadoAId, asignadoA2Id) solo serviria para la primera;
  /// separados, Postgres puede usar los dos y combinarlos (bitmap OR).
  ///
  /// Tambien los usa usuarios.service.ts#eliminar, que hace updateMany por
  /// cada una al dar de baja una cuenta.
  /// Ver backend/docs/rendimiento-db.md (H5).
  @@index([asignadoAId])
  @@index([asignadoA2Id])
  @@map("hojas_conteo")
}

/// tipos.ts#Producto. Un producto tiene VARIOS Empaque (decision del
/// cliente: un mismo item puede venir en Caja x12 Y Pack x6) -- antes era
/// un Empaque embebido en columnas planas, un solo empaque por producto.
model Producto {
  id           Int    @id @default(autoincrement())
  hojaId       Int    @map("hoja_id")
  hoja         HojaConteo @relation(fields: [hojaId], references: [id])
  /// codigo interno del item en la hoja: "0051".
  codigo       String
  /// codigo de barras de la unidad SUELTA.
  codigoBarras String @map("codigo_barras")
  descripcion  String
  ubicacion    String?
  /// La categoria de Dynamics con la que se agrupo la hoja (ver
  /// CatalogoItem.categoria). Se copia al materializar la hoja para que el
  /// operario vea EN QUE SECTOR esta parado sin tener que deducirlo de los
  /// nombres. No viola el conteo ciego: es ubicacion, no stock ni precio.
  categoria    String?

  /// SIEMPRE al menos uno (tipos.ts#Producto.empaques, "[0] = el que se
  /// ofrece primero al abrir el modal") -- lo exige la capa de aplicacion,
  /// no un CHECK de Postgres (mismo criterio que Colaborador.sucursalId).
  empaques Empaque[]
  conteos  Conteo[]

  @@unique([hojaId, codigo])
  @@index([hojaId, codigoBarras])
  @@map("productos")
}

/// tipos.ts#Empaque. Sigue siendo un value object en el dominio del front
/// (no tiene id propio, tipos.ts lo dice explicito) -- pero ahora es una
/// LISTA por producto, y una lista necesita filas propias en Postgres: el
/// `id` de esta tabla es tecnico e interno, nunca sale en los DTOs (ver
/// hojas.service.ts#EmpaqueDto, que no tiene id).
///
/// La unidad SUELTA no es una fila de esta tabla -- sigue viviendo en
/// Producto.codigoBarras/EmpaqueCatalogo aparte, mismo criterio que
/// mobile/lib/dominio/tipos.ts: mezclar "empaque cerrado" y "unidad suelta"
/// en la misma lista es como se cuelan los bugs de conteo.
model Empaque {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  nombre String // "Caja", "Pack", "Plancha", "Fardo"
  factor Int    // 12, 6, 24, 20
  /// Casi siempre vacio: el ERP real (Dynamics, tenant de Market Trujillo)
  /// SOLO trae codigos de barra de la unidad suelta -- ningun empaque tiene
  /// uno propio en la muestra real (ver d365.types.ts#D365ProductBarcode).
  /// Opcional de verdad, no solo en el tipo: el mapeo de catalogo nunca lo
  /// inventa (d365-catalogo.service.ts#mapearProducto).
  codigoBarras String? @map("codigo_barras")
  /// Orden de oferta en el modal: 0 = el que se ofrece primero (ver el
  /// comentario de Producto.empaques mas arriba). Sin esta columna, Postgres
  /// no garantiza ningun orden estable entre las filas de un mismo producto.
  orden Int @default(0)

  /// Los nombres no se repiten dentro del listado de un producto -- mismo
  /// criterio que LineaConteo.empaqueNombre (abajo), identificado por
  /// nombre y no por este id porque el dominio del front tampoco lo tiene.
  @@unique([productoId, nombre])
  @@map("empaques")
}

/// tipos.ts#Conteo. El total NUNCA se guarda -- se calcula desde las lineas
/// de empaques y las sueltas (ver hojas.calculos.ts#totalUnidades).
/// Guardar un total junto a sus partes es garantizar que algun dia no
/// coincidan (comentario textual de tipos.ts): por eso este modelo no tiene
/// columna `total`.
model Conteo {
  id     Int        @id @default(autoincrement())
  hojaId Int        @map("hoja_id")
  hoja   HojaConteo @relation(fields: [hojaId], references: [id])

  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  /// El operario puede cargar varias lineas para el mismo producto (ej. "2
  /// cajas + 3 packs + 5 sueltas") -- antes era un entero, un solo empaque.
  empaques LineaConteo[]
  sueltas  Int
  /// Marcado por el escaner: el fisico coincide con lo que dice la linea.
  confirmadoPorEscaner Boolean  @default(false) @map("confirmado_por_escaner")
  contadoEn            DateTime @map("contado_en")

  @@unique([hojaId, productoId])
  /// NO es redundante con el @@unique de arriba, y la razon es la regla del
  /// PREFIJO IZQUIERDO: un indice compuesto (hojaId, productoId) sirve para
  /// filtrar por `hojaId`, o por los dos juntos -- pero NO para filtrar solo
  /// por `productoId`, que es la segunda columna. Postgres no puede saltarse
  /// la primera.
  ///
  /// Y por productoId solo se filtra en todos lados: cada `include: {
  /// conteos: ... }` colgado de Producto lo hace (auditoria.service.ts#armarMatriz,
  /// rondas.service.ts#contadoHastaLaRonda), y son las consultas que a escala
  /// real cruzan ~9.400 productos por inventario.
  ///
  /// Postgres NO indexa las claves foraneas solo -- a diferencia de MySQL, y
  /// Prisma tampoco lo hace. Sin esta linea, esa columna no tiene indice.
  /// Ver backend/docs/rendimiento-db.md (H3, H6, H8).
  @@index([productoId])
  @@map("conteos")
}

/// tipos.ts#LineaEmpaque. Identificada por NOMBRE, no por FK a Empaque.id
/// -- mismo criterio que el dominio del front (Empaque es un value object
/// sin id) y que mobile/lib/adaptadores/hojas-sqlite.ts (la cola offline
/// tambien guarda sus lineas por nombre). Que el nombre exista de verdad
/// entre los empaques DEL producto lo valida la capa de aplicacion
/// (hojas.calculos.ts#totalUnidades), igual que en el dominio del front.
model LineaConteo {
  id       Int    @id @default(autoincrement())
  conteoId Int    @map("conteo_id")
  conteo   Conteo @relation(fields: [conteoId], references: [id], onDelete: Cascade)

  empaqueNombre String @map("empaque_nombre")
  cantidad      Int

  /// Una sola linea por empaque dentro de un mismo conteo -- no dos filas
  /// "Caja" para el mismo producto.
  @@unique([conteoId, empaqueNombre])
  @@map("lineas_conteo")
}

/// LA LISTA DE PRESENTES, cargada por el Coordinador. Una fila = "esta
/// persona vino este dia".
///
/// QUE REEMPLAZA: hasta este cambio la asistencia se DEDUCIA de las hojas --
/// "tenes una hoja con al menos un conteo, entonces viniste"
/// (dominio/asistencia.ts). Esa regla le cobraba multa a quien vino y no
/// llego a cargar un renglon; el cliente habia aceptado ese costo por
/// escrito y ahora lo revirtio. El dato pasa de inferido a DECLARADO, y
/// quien lo declara queda registrado (`registradoPorId`).
///
/// SOLO ENTRADA, NO HAY SALIDA. No es un reloj de fichada: la liquidacion
/// necesita saber si la persona ESTUVO ese dia, no cuantas horas. Una salida
/// obligaria al Coordinador a acordarse de cerrar cada jornada, y una salida
/// sin cargar no se distinguiria de una ausencia -- el mismo problema que se
/// acaba de sacar de encima.
///
/// EL DIA ES EL DATO, LA HORA ES EL RASTRO. `dia` (sin hora) es lo unico que
/// entra al calculo de la multa; `registradoEn` guarda el INSTANTE de la
/// marca -- que es la hora de entrada, porque el Coordinador marca cuando ve
/// llegar a la persona -- y existe para poder auditar despues ("esta marca
/// tiene hora de las 22:00"). Ninguno de los dos reemplaza al otro.
///
/// LA DURACION DEL INVENTARIO SALE DE ACA: los dias DISTINTOS con al menos
/// una marca de cualquiera. No se declara en ningun lado, a proposito -- una
/// duracion declarada y las marcas reales discrepan el primer dia que el
/// inventario se estira, y la multa se cobra sobre esa diferencia. Se congela
/// en `ResultadoInventario.diasDelInventario` al cerrar el conteo.
///
/// LAS TRES FK VAN EN RESTRICT, como el resto del esquema: nada de esta
/// tabla desaparece en silencio. Nacio sin ninguna -- los ids iban pelados --
/// y se corrigio en 20260918160000_asistencia_claves_foraneas; el detalle de
/// por que RESTRICT y no CASCADE esta en esa migracion.
///
/// La consecuencia operativa, que hay que recordar al escribir un script:
/// esta es la NOVENA FK RESTRICT hacia `inventarios`. Todo lo que borre un
/// inventario tiene que borrar sus marcas ANTES, o Postgres lo frena. Y a
/// diferencia de las otras ocho, estas marcas pueden existir en un inventario
/// SIN UN SOLO CONTEO: el Coordinador pasa lista cuando la gente llega, no
/// cuando termina de contar.
model AsistenciaInventario {
  id              Int        @id @default(autoincrement())
  inventarioId    Int        @map("inventario_id")
  inventario      Inventario @relation(fields: [inventarioId], references: [id])

  /// A quien se le marca la entrada.
  colaboradorId   Int         @map("colaborador_id")
  colaborador     Colaborador @relation("ColaboradorMarcado", fields: [colaboradorId], references: [id])
  /// El dia de la jornada (sin hora). La cantidad de dias DISTINTOS con
  /// al menos una marca es la duracion del inventario.
  dia             DateTime @db.Date
  /// Fecha y HORA de la entrada -- solo entrada, no hay salida.
  registradoEn    DateTime @default(now()) @map("registrado_en")
  /// Quien la cargo. La asistencia mueve plata (multa y bono): una marca sin
  /// autor es una decision que despues nadie puede explicar, misma razon que
  /// `ResultadoInventario.ajustesPorId`. Va en RESTRICT y no en SET NULL --
  /// a diferencia de `ajustesPorId` -- porque aca la columna es obligatoria:
  /// una marca sin autor no es un estado valido al que se pueda degradar.
  registradoPorId Int         @map("registrado_por_id")
  registradoPor   Colaborador @relation("AsistenciaRegistradaPor", fields: [registradoPorId], references: [id])

  /// UNA marca por persona y dia. Hace la carga IDEMPOTENTE -- el
  /// Coordinador puede tocar el boton dos veces, o dos coordinadores marcar
  /// a la misma persona, sin que a nadie le sobren dias de asistencia.
  @@unique([inventarioId, colaboradorId, dia])
  @@map("asistencia_inventario")
}

/// UNA FALTA PERDONADA POR EL AUDITOR. Una fila = "esta persona no vino este
/// dia, y no se le cobra".
///
/// Decision del cliente, textual: "si cobra el bono de distribucion, es como
/// si hubiera asistido". O sea que un dia justificado vale como asistido para
/// LOS DOS efectos: no paga multa POR ese dia y, si con eso completa el
/// inventario, cobra el bono. No es media medida -- no existe "te perdono la
/// multa pero no cobras bono".
///
/// POR QUE UNA TABLA APARTE, Y NO UNA MARCA MAS EN `asistencia_inventario`:
/// porque son dos hechos distintos y uno de ellos se firma. Una marca afirma
/// "esta persona ESTUVO"; una justificacion afirma "no estuvo, y esta bien".
/// Meter las justificaciones entre las marcas haria que
/// `LiquidacionColaborador.diasAsistidos` -- que va DENTRO DEL SELLO del
/// lacrado (historial.lacrado.ts) -- dijera que alguien estuvo un dia que no
/// estuvo. Ese sello existe para poder defender la planilla cuando alguien
/// reclama; si para cuadrar la plata afirma un hecho falso, deja de servir
/// justo el dia que hace falta. Para la PLATA se suman; para el RELATO, no.
///
/// Y de yapa, separadas se puede responder "cuantos dias falto Delia y
/// cuantos se le perdonaron", que es exactamente la pregunta del reclamo.
///
/// SOLO EL AUDITOR justifica (asistencia.permisos.ts). No el Coordinador, que
/// es quien pasa lista: quien registra la ausencia no puede ser el mismo que
/// la perdona, o el control se vuelve una formalidad. Es el mismo criterio
/// por el que el Coordinador no se marca a si mismo presente.
///
/// LA VENTANA SE CIERRA AL LIQUIDAR. Despues la planilla esta firmada y los
/// montos descontados: una justificacion tardia cambiaria un descuento que ya
/// salio en un recibo de sueldo. Mientras tanto SI se puede justificar con el
/// conteo ya cerrado -- es cuando el auditor mira la planilla y aparece el
/// reclamo.
model JustificacionAsistencia {
  id               Int        @id @default(autoincrement())
  inventarioId     Int        @map("inventario_id")
  inventario       Inventario @relation(fields: [inventarioId], references: [id])

  /// A quien se le perdona la falta.
  colaboradorId    Int         @map("colaborador_id")
  colaborador      Colaborador @relation("ColaboradorJustificado", fields: [colaboradorId], references: [id])

  /// El dia que se perdona, sin hora -- el mismo formato y el mismo
  /// significado que `AsistenciaInventario.dia`, para poder cruzarlos.
  dia              DateTime    @db.Date

  /// POR QUE se perdona. OBLIGATORIO, y no es burocracia: esta fila le saca
  /// plata de la multa a una persona y se la agrega al bono de todas las
  /// demas (el fondo se reparte entre menos gente o entre mas). Un perdon sin
  /// motivo es un movimiento de plata entre companeros que nadie puede
  /// explicar. Va en la fila y NO solo en el log de auditoria porque es parte
  /// del dato, no de su historia.
  motivo           String

  justificadoEn    DateTime    @default(now()) @map("justificado_en")
  justificadoPorId Int         @map("justificado_por_id")
  justificadoPor   Colaborador @relation("JustificacionRegistradaPor", fields: [justificadoPorId], references: [id])

  /// UN perdon por persona y dia. Hace la carga idempotente y, sobre todo,
  /// impide que dos justificaciones del mismo dia le descuenten DOS dias de
  /// multa a alguien que solo falto uno.
  @@unique([inventarioId, colaboradorId, dia])
  @@map("justificaciones_asistencia")
}

// ---------------------------------------------------------------------------
// Historico: cierre, lacrado y resultados
//
// Todo lo de esta seccion existe para una sola pregunta del cliente: "donde
// llevaremos el control y el historico de los inventarios". La respuesta es
// Inventario (arriba) + estas cinco tablas.
//
// Regla transversal, heredada del comentario de Conteo: NINGUN total
// derivable se guarda junto a sus partes. `itemsCuadrados`, el faltante neto
// y el descuento total de cada colaborador se CALCULAN (ver
// modules/historial/historial.calculos.ts). Guardar un total al lado de sus
// sumandos es garantizar que algun dia no coincidan.
// ---------------------------------------------------------------------------

/// EL SELLO DEL MES. Es lo que Oscar describe en la reunion como "cierras,
/// firmas, sellas y lacras" (docs/pantallas.md, Pantalla 7) y lo que la
/// maqueta mobile/design/lacrado.html muestra como "Hash ID".
///
/// INMUTABILIDAD -- como la sostiene este modelo, en tres niveles:
///
///  1. Relacion 1:1 con Inventario (`inventarioId @unique`): un inventario
///     se lacra UNA vez. No hay forma de tener dos sellos del mismo mes ni
///     de "re-lacrar" con otro contenido.
///  2. Esta tabla NO tiene `updatedAt`, a diferencia de todos los demas
///     modelos escribibles del schema. La ausencia es deliberada: no hay
///     campo donde registrar una modificacion porque no debe existir
///     ninguna. Un lacrado se inserta y nunca se toca.
///  3. `hash` + `contenido`: el sello es VERIFICABLE, no una promesa. Se
///     puede recalcular el hash sobre el estado actual del inventario y
///     compararlo con el guardado (endpoint GET .../lacrado/verificacion).
///     Si alguien altero una hoja despues del cierre, los hashes difieren y
///     el sistema lo dice. Una regla de inmutabilidad que no se puede
///     comprobar no es un control, es un cartel.
///
/// Falta el cuarto nivel, que Prisma no sabe declarar y va a mano en la
/// migracion: revocar UPDATE/DELETE sobre `lacrados_inventario` (o un
/// trigger BEFORE UPDATE que lance excepcion). Queda anotado en el README
/// como paso de la migracion, no se finge que el schema ya lo cubre.
model LacradoInventario {
  id           Int        @id @default(autoincrement())
  /// @unique = 1:1: un inventario se lacra una sola vez.
  inventarioId Int        @unique @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  /// Folio legible que ve la gente: "INV-2026-08-LUZ-8000-K99"
  /// (mobile/design/lacrado.html). Es el identificador que se cita en un
  /// mail o en un acta -- nadie dicta 64 caracteres hexadecimales por
  /// telefono. No reemplaza al hash: el folio identifica, el hash sella.
  folio        String     @unique

  /// SHA-256 en hexadecimal (64 chars) de `contenido`, serializado en forma
  /// canonica (claves ordenadas, sin espacios) -- si no es canonico, dos
  /// serializaciones del mismo dato dan hashes distintos y la verificacion
  /// no sirve para nada.
  hash          String    @unique
  /// Versionado a proposito: el dia que se cambie de algoritmo, los
  /// lacrados viejos siguen siendo verificables porque cada fila dice con
  /// que se calculo el suyo.
  hashAlgoritmo String    @default("sha256") @map("hash_algoritmo")
  /// QUE se hasheo, exactamente. Sin esto, el hash es un numero magico que
  /// nadie puede recomputar dentro de dos anios: el sello tiene que
  /// arrastrar su propio insumo. Incluye los totales del inventario, el
  /// resumen de diferencias, la planilla de liquidacion y las aprobaciones.
  contenido     Json

  lacradoEn     DateTime  @default(now()) @map("lacrado_en")
  /// Quien apreto el boton. Distinto de las aprobaciones: aprobar es
  /// validar el resultado, lacrar es ejecutar el cierre.
  lacradoPorId  Int         @map("lacrado_por_id")
  lacradoPor    Colaborador @relation("LacradoPor", fields: [lacradoPorId], references: [id])

  /// El registro manual en Dynamics NO vive en esta tabla, aunque la maqueta
  /// lo muestre en la pantalla de al lado: es un hecho POSTERIOR al sello y
  /// meterlo aca obligaria a hacer UPDATE sobre la fila del lacrado, que es
  /// justo lo que esta tabla no debe aceptar nunca. Vive en
  /// RegistroErpInventario, 1:1 -- asi `lacrados_inventario` queda
  /// append-only de verdad y la migracion puede revocarle el UPDATE sin
  /// romper ninguna funcionalidad.
  registroErp RegistroErpInventario?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("lacrados_inventario")
}

/// Constancia de que TI cargo el ajuste a mano en Dynamics.
///
/// Tabla aparte del lacrado por dos razones, y la segunda es la que manda:
///  1. Son dos hechos distintos en dos momentos distintos -- la maqueta los
///     muestra como dos tarjetas separadas, y un inventario puede quedar
///     lacrado y sin registrar en el ERP por dias.
///  2. Deja que `lacrados_inventario` sea append-only sin excepciones. Una
///     tabla "inmutable salvo estas tres columnas" no es inmutable: es una
///     tabla con una puerta, y las puertas se usan.
///
/// El envio automatico a Dynamics es FASE 2 (docs/pantallas.md, Decision 5):
/// este backend NO escribe al ERP, solo deja constancia de que alguien lo
/// hizo. Por eso `referencia` es texto libre -- es el numero de asiento o
/// diario que TI copia del ERP, no algo que el sistema genere.
model RegistroErpInventario {
  id        Int               @id @default(autoincrement())
  lacradoId Int               @unique @map("lacrado_id")
  lacrado   LacradoInventario @relation(fields: [lacradoId], references: [id])

  /// Numero de asiento/diario del ERP, para poder rastrearlo despues.
  referencia   String?
  registradoEn DateTime    @default(now()) @map("registrado_en")
  registradoPorId Int      @map("registrado_por_id")
  registradoPor Colaborador @relation("RegistradoEnErpPor", fields: [registradoPorId], references: [id])

  @@map("registros_erp_inventario")
}

/// Las DOS aprobaciones que habilitan el lacrado (Gilmer y Michell en la
/// reunion; Gilmer Quispe y Rosa Melgarejo en la maqueta).
///
/// Cuelga de Inventario y NO de LacradoInventario, aunque el sello sea el
/// producto final: las aprobaciones ocurren ANTES de lacrar -- se van
/// juntando de a una y el boton de lacrar recien se habilita cuando hay dos
/// (mobile/design/lacrado.html). Colgarlas del lacrado obligaria a crear el
/// sello antes de tener las firmas que lo justifican, que es exactamente al
/// reves de como funciona el control.
model AprobacionCierre {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  aprobadorId  Int         @map("aprobador_id")
  aprobador    Colaborador @relation("AprobadorCierre", fields: [aprobadorId], references: [id])
  /// Rol CONGELADO al momento de firmar. Si manana esa persona cambia de
  /// rol o se deshabilita, la firma tiene que seguir diciendo con que
  /// autoridad se dio -- leerlo de Colaborador.rol reescribiria el pasado.
  rolAlAprobar Rol         @map("rol_al_aprobar")
  aprobadoEn   DateTime    @default(now()) @map("aprobado_en")
  /// Observacion opcional de quien aprueba ("aprobado con reserva por X").
  nota         String?

  /// Nadie firma dos veces: dos aprobaciones de la misma persona no son
  /// una doble validacion. La regla de "tienen que ser DOS personas
  /// distintas" sale gratis de esta restriccion.
  @@unique([inventarioId, aprobadorId])
  @@map("aprobaciones_cierre")
}

/// Resumen del inventario, 1:1: es la fila que responde "como fue el
/// inventario de agosto" sin recorrer 8.000 conteos. Se escribe al cerrar
/// el conteo y ya no cambia.
///
/// Que NO esta aca, a proposito (regla de "ningun total derivable"):
///   - itemsCuadrados    = itemsTotales - itemsConDiferencia
///   - montoFaltanteNeto = bruto - negativos - empresa
///   - cuotaBase         = neto / colaboradoresAlcanzados
///   - bonoAsistencia    = fondo de multas / asistentes
/// Todos se calculan en historial.calculos.ts, que se testea sin base.
model ResultadoInventario {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @unique @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  /// -- Embudo de los conteos (docs/pantallas.md, Pantalla 4) --
  /// Universo contado en la 1ra ronda (8.000 en el ejemplo del cliente).
  itemsTotales       Int @map("items_totales")
  /// Los que quedaron con diferencia DESPUES de la ULTIMA ronda (130 en el
  /// ejemplo). Los cuadrados se derivan restando.
  itemsConDiferencia Int @map("items_con_diferencia")
  /// Cuantos entraron a cada reconteo -- es el embudo que dibuja la
  /// Pantalla 4 y lo que permite comparar "cuanto mejoro el 2do conteo
  /// respecto de agosto" entre periodos.
  ///
  /// ESTAS DOS COLUMNAS SE QUEDARON EN TRES RONDAS, y hay que saberlo antes
  /// de leer un embudo: desde que el Auditor puede abrir una 4ta y una 5ta,
  /// no hay donde anotar quienes entraron a esas. El efecto no es un hueco,
  /// es un numero MAL ATRIBUIDO: historial.calculos.ts#calcularEmbudo calcula
  /// `resueltosEnTercero = itemsTercerConteo - itemsConDiferencia`, asi que
  /// en un inventario de 5 rondas le adjudica a la 3ra todo lo que se
  /// resolvio en la 3ra, la 4ta y la 5ta.
  ///
  /// Queda anotado y no arreglado a proposito: arreglarlo es cambiar la forma
  /// de lo que se guarda (una columna por ronda no escala; lo que escala es
  /// una lista, como ya hizo el dominio con `ItemAuditoria.conteos`), eso
  /// entra al sello del lacrado y obliga a subir VERSION_CONTENIDO_LACRADO.
  /// Es una decision del equipo, no de este archivo. Mientras tanto, un
  /// inventario de 3 rondas -- el caso normal -- sigue dando el embudo
  /// correcto.
  itemsSegundoConteo Int @map("items_segundo_conteo")
  itemsTercerConteo  Int @map("items_tercer_conteo")

  /// -- Unidades (no plata): faltante y sobrante en cantidad fisica --
  unidadesFaltantes Int @map("unidades_faltantes")
  unidadesSobrantes Int @map("unidades_sobrantes")

  /// -- Plata (Pantalla 6) -- Decimal, NUNCA Float: la plata en coma
  /// flotante es como se pierden centavos que despues nadie sabe explicar.
  montoFaltanteBruto   Decimal @default(0) @map("monto_faltante_bruto")   @db.Decimal(12, 2)
  /// Ajustes de entradas/salidas del mes que reporta Jocelyn, a favor del
  /// personal (docs/pantallas.md, Pantalla 6).
  ///
  /// NULLABLE, y la razon importa (mismo criterio que
  /// CatalogoItem.stockErp): NULL = todavia no se cargaron los ajustes de
  /// este mes, DISTINTO de 0 = "no hubo ajustes". Quien lea el resultado
  /// calcula igual con 0 como placeholder, pero
  /// liquidacion.service.ts#armarAdvertencia tiene que avisarlo ANTES de
  /// que alguien firme, no despues.
  ///
  /// LO CARGA `PUT /api/liquidacion/inventarios/:id/ajustes`
  /// (liquidacion.ajustes.ts), solo mientras el inventario esta en
  /// `conteo_cerrado`. Un 0 EXPLICITO por esa via es un dato verificado
  /// ("alguien miro y no habia"), y por eso destraba la liquidacion: la
  /// diferencia entre ese 0 y este NULL es toda la regla.
  montoNegativos       Decimal? @map("monto_negativos") @db.Decimal(12, 2)
  /// Faltante que absorbe la empresa y no se descuenta (las cervezas del
  /// ejemplo del cliente).
  montoFaltanteEmpresa Decimal @default(0) @map("monto_faltante_empresa") @db.Decimal(12, 2)
  /// Sobrante que va A FAVOR del personal: valor de los sobrantes de
  /// productos NO empresa, a precio de venta -- misma valorizacion que
  /// montoFaltanteBruto. NO es `unidadesSobrantes` (cantidad fisica, empresa
  /// incluida) ni el `valorSobrante` de auditoria.calculos.ts (suma tambien
  /// los de empresa, y los productos de empresa no entran a la liquidacion,
  /// ni en contra ni a favor).
  ///
  /// Congelado AL LIQUIDAR (liquidacion.cierre.ts#liquidar), en la misma
  /// transaccion que la planilla, con la clasificacion efectiva de ese
  /// momento: ClasificacionProducto vigente ?? CatalogoItem.esEmpresa.
  /// Motivo: si el Auditor reclasifica un producto despues del cierre del
  /// conteo, tiene que aplicar igual a la liquidacion.
  ///
  /// NULLABLE y SIN relleno para atras: NULL = "no se liquido con esta
  /// regla" -- todavia no se liquido, o se liquido antes de que existiera.
  /// historial.service.ts#resumirResultado RECALCULA el neto en cada
  /// lectura, asi que ponerle un valor a un inventario ya liquidado
  /// cambiaria el neto que muestra el historico -- distinto del que se
  /// desconto de verdad. Por eso la formula lee NULL como "sin compensacion
  /// de sobrantes" (historial.calculos.ts), y 0 = "se calculo y no hubo".
  montoSobranteEmpleado Decimal? @map("monto_sobrante_empleado") @db.Decimal(12, 2)

  /// -- Reparto (Pantalla 6) --
  /// Entre CUANTA gente se divide el neto: todo el personal habilitado de
  /// la tienda (11 en el ejemplo), no solo quienes asistieron a contar.
  colaboradoresAlcanzados Int @map("colaboradores_alcanzados")
  /// De esos, cuantos CUMPLIERON LA ASISTENCIA COMPLETA: vinieron TODOS los
  /// dias del inventario, o sea los que no pagan multa. La diferencia son
  /// quienes faltaron al menos un dia, pagan multa por cada uno y alimentan
  /// el fondo que se redistribuye.
  ///
  /// CAMBIO DE SIGNIFICADO, y el numero puede bajar: antes era "cuantos
  /// vinieron alguna vez", deducido de las hojas -- tener una hoja con al
  /// menos un conteo alcanzaba. Con la multa prorrateada por dia, "el que
  /// asistio" dejo de ser una categoria util: en un inventario de tres dias
  /// casi todos asistieron ALGUN dia. Lo que hay que contar es quienes
  /// cobran bono, y esos son los de asistencia completa
  /// (`dominio/asistencia.ts#quienesAsistieronTodo`).
  ///
  /// SALE DE LAS MARCAS de `asistencia_inventario`, que carga el Coordinador
  /// a mano: ya no se deduce de las hojas. Lo escribe el cierre del conteo
  /// (rondas.service.ts#cerrar), en la misma transaccion que el resto del
  /// resultado y que `diasDelInventario`, que es su denominador.
  ///
  /// Los sellos de lacrado viejos NO se rompen: el campo entra al hash desde
  /// v1 (historial.lacrado.ts) pero lo que se sella es el VALOR que se
  /// guardo, y ese no se toca -- cambia como se calcula de aca en adelante,
  /// no lo que ya esta escrito.
  ///
  /// SIGUE NULLABLE, y ya no por lo mismo: los inventarios cerrados ANTES de
  /// que existiera la regla tienen NULL de verdad, y ahi NULL significa "esto
  /// se cerro cuando nadie sabia quien vino" -- distinto de 0 = "no vino
  /// nadie". Liquidar uno de esos repartiria un fondo de multas calculado
  /// sobre una asistencia que no existe, y por eso liquidacion.cierre.ts
  /// sigue chequeandolo.
  ///
  /// La contracara por persona es `LiquidacionColaborador.asistio`, que sale
  /// de la MISMA regla y la MISMA consulta: este campo es CUANTOS, aquel es
  /// QUIENES, y no pueden discrepar.
  colaboradoresAsistieron Int? @map("colaboradores_asistieron")
  /// CUANTOS DIAS DURO el inventario: dias distintos con al menos una marca
  /// en `asistencia_inventario` (dominio/asistencia.ts#diasDelInventario).
  /// Congelado al cerrar el conteo, en la misma transaccion que el resto del
  /// resultado, y por la misma razon que todo lo demas de esta tabla: es el
  /// DENOMINADOR de todas las multas del inventario. Sin congelarlo, una
  /// marca cargada en noviembre -- o una borrada -- cambiaria la multa de
  /// agosto, que ya se descontó de un sueldo.
  ///
  /// 0 significa "este inventario se cerro cuando la asistencia todavia se
  /// deducia de las hojas", no "duro cero dias": con 0 dias la formula nueva
  /// da multa 0 para todos, que es exactamente lo que corresponde a una
  /// planilla ya firmada con la regla vieja (sus montos viven congelados en
  /// `liquidaciones_colaborador`, no se recalculan). `prisma/rellenar-asistencia.ts`
  /// lo completa para los inventarios ya cerrados, junto con sus marcas.
  ///
  /// NO es NULLABLE, a diferencia de `colaboradoresAsistieron`: aquel
  /// distingue "no se sabe quien vino" de "no vino nadie" porque alimenta una
  /// guarda ANTES de liquidar; este solo multiplica, y 0 ya es la respuesta
  /// correcta para el caso viejo.
  diasDelInventario Int @default(0) @map("dias_del_inventario")
  /// TARIFA POR DIA de inasistencia vigente en este inventario (S/20 hoy).
  ///
  /// CAMBIO DE SIGNIFICADO, y es el mismo numero: hasta la asistencia
  /// registrada esto era el monto TOTAL que pagaba un ausente, UNA vez --
  /// faltar un dia de tres costaba igual que no aparecer nunca. Ahora es el
  /// precio de UN dia faltado, y la multa de cada persona es
  ///     (diasDelInventario - dias que asistio) * esta tarifa
  /// (dominio/asistencia.ts#multaPorInasistencia).
  ///
  /// Los inventarios cerrados ANTES del cambio guardan 20 con el significado
  /// viejo y no se tocan: su `diasDelInventario` es 0, asi que la formula
  /// nueva no los reinterpreta.
  ///
  /// Congelado igual que tamanoHoja: si manana la tarifa sube, el historico
  /// tiene que seguir liquidando agosto con la de agosto.
  multaInasistencia Decimal @default(20) @map("multa_inasistencia") @db.Decimal(12, 2)

  calculadoEn DateTime @default(now()) @map("calculado_en")

  // ---------------------------------------------------------------------------
  // Quien cargo los ajustes del mes, y cuando
  // ---------------------------------------------------------------------------
  //
  // `montoNegativos` y `montoFaltanteEmpresa` bajan el faltante que se
  // descuenta a nomina: son plata que alguien decide NO cobrarle al personal.
  // Un monto asi no puede quedar sin firma -- si en tres meses alguien
  // pregunta por que agosto tuvo S/380 de ajustes, la respuesta tiene que
  // estar en la fila, no en la memoria de nadie.
  //
  // Los tres son NULL mientras nadie los haya cargado, y se escriben juntos
  // (ver liquidacion.ajustes.ts): tener fecha sin autor, o monto sin nota,
  // seria un registro a medias de una decision que mueve plata.

  /// Quien cargo los ajustes. NULL = todavia nadie.
  ajustesPorId Int?         @map("ajustes_por_id")
  ajustesPor   Colaborador? @relation("AjustesRegistrados", fields: [ajustesPorId], references: [id])
  ajustesEn    DateTime?    @map("ajustes_en")
  /// Por que ese monto. Obligatoria al cargar -- un ajuste sin explicacion es
  /// un numero que nadie puede auditar despues.
  ajustesNota  String?      @map("ajustes_nota")

  @@map("resultados_inventario")
}

/// Una fila por item que NO cuadro. Es la mitad del historico que el cliente
/// pidio: "este producto, cuantas veces dio diferencia este ano".
///
/// Guarda `codigo` y `descripcion` como TEXTO en vez de una FK a Producto, y
/// no es desprolijidad: Producto cuelga de HojaConteo, que cuelga de UN
/// inventario. Cruzar el mismo articulo entre agosto y septiembre por FK es
/// imposible -- son filas distintas de Producto. El ItemNumber de Dynamics
/// es la unica identidad estable del articulo a traves de los meses, asi que
/// el historico se indexa por el. La `descripcion` viaja copiada por la
/// misma razon que `tamanoHoja`: si el articulo se renombra en Dynamics, el
/// inventario de agosto tiene que seguir diciendo como se llamaba en agosto.
model DiferenciaItem {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  /// ItemNumber de Dynamics -- la identidad estable entre periodos.
  codigo      String
  descripcion String

  /// Lo que decia el ERP contra el valor que quedo FIJO al cerrar el conteo:
  /// la ultima ronda, o el ajuste del auditor si lo hubo (el ajuste reemplaza
  /// el valor contado, ver RegistroAuditoria).
  stockSistema Int @map("stock_sistema")
  conteoFinal  Int @map("conteo_final")
  /// conteoFinal - stockSistema. Negativo = faltante, positivo = sobrante.
  /// Este SI se guarda aunque sea derivable de las dos columnas de al lado:
  /// es la columna por la que se filtra y se ordena el historico ("los 20
  /// peores faltantes del ano"), y calcularlo con una expresion en cada
  /// query impide usar un indice.
  diferencia   Int

  /// En que ronda quedo resuelto. Es un NUMERO de ronda y no tiene tope --
  /// puede ser 4 o 5 si el auditor abrio rondas extra (ver
  /// HojaConteo.numeroConteo). Permite responder "cuantos se arreglaron solos
  /// en el 2do conteo" sin recorrer las hojas.
  resueltoEnConteo Int @map("resuelto_en_conteo")

  /// El precio unitario con el que se valorizo esta diferencia, congelado al
  /// momento del cierre.
  ///
  /// ES EL PRECIO DE VENTA, NO UN COSTO, y el nombre lo dice a proposito.
  /// Se llamaba `costoUnitario` por un modelado anterior a la decision del
  /// cliente, y ese nombre mentia por dos motivos a la vez:
  ///
  ///   1. El snapshot de Dynamics NO TRAE COSTO. `CatalogoItem` tiene
  ///      `precioVenta` y nada mas, asi que no habia con que llenar una
  ///      columna de costo aunque se quisiera.
  ///   2. El cliente definio en reunion que las diferencias se valorizan a
  ///      precio de VENTA (ver auditoria.calculos.ts#diferenciaValor,
  ///      "nunca precio de compra", y CatalogoItem.precioVenta).
  ///
  /// Una columna llamada `costo_unitario` con un precio de gondola adentro
  /// es la misma clase de error que `stockErp ?? 0`: el dato esta bien y el
  /// nombre hace que se lea mal. Quien abra la tabla dentro de un ano y vea
  /// "costo" va a calcular margenes con precios de venta.
  ///
  /// 4 decimales, igual que el origen: se redondea al multiplicar, no antes.
  /// Nullable: si el snapshot no trajo precio, la diferencia en unidades
  /// sigue siendo valida aunque no se pueda valorizar -- y es justo esa la
  /// que cuenta liquidacion.service.ts#contarItemsSinPrecio para advertirle
  /// a quien firma que el monto puede estar subestimado.
  precioUnitario  Decimal? @map("precio_unitario")  @db.Decimal(12, 4)
  montoDiferencia Decimal? @map("monto_diferencia") @db.Decimal(12, 2)

  /// Clasificacion EFECTIVA del item (ClasificacionProducto vigente ??
  /// CatalogoItem.esEmpresa), congelada AL LIQUIDAR: la escribe
  /// liquidacion.reclasificacion.ts dentro de la transaccion de
  /// liquidacion.cierre.ts#liquidar. Motivo: si el Auditor reclasifica un
  /// producto despues del cierre del conteo, tiene que aplicar igual.
  /// Es lo que filtra el reporte a gerencia (sobrantes y faltantes de
  /// productos de empresa) sin volver a cruzar contra el catalogo.
  ///
  /// El cierre del conteo (rondas.service.ts#cerrar) NO la escribe: la fila
  /// nace con el @default(false), que es PROVISORIO hasta liquidar. Antes
  /// de eso no dice nada sobre el item.
  ///
  /// Filas anteriores a esta columna: la migracion las relleno con el
  /// `es_empresa` de su CatalogoItem (mismo inventario, mismo codigo), el
  /// valor con el que esos inventarios calcularon montoFaltanteEmpresa.
  esEmpresa Boolean @default(false) @map("es_empresa")

  /// La clase EFECTIVA con la que se liquido este item -- ver `ClaseItem`.
  ///
  /// Congelada junto al resto de la fila y por la misma razon que `esEmpresa`
  /// al lado: es lo que explica por que el faltante de este item se le
  /// descontó al personal, fue al cuadro de faltante por paquete, o no se
  /// descontó a nadie.
  ///
  /// NULL en las diferencias congeladas ANTES de que existieran las tres
  /// vias, y ahi NULL significa "se cerro con la regla de dos vias": manda
  /// `esEmpresa`. NO se rellena para atras, mismo criterio que
  /// `ResultadoInventario.montoSobranteEmpleado` -- ponerle un valor a un
  /// inventario ya liquidado afirmaria una regla que no se uso.
  clase        ClaseItem? @map("clase")

  createdAt DateTime @default(now()) @map("created_at")

  /// Un item aparece una sola vez por inventario: la diferencia es el
  /// resultado FINAL del ciclo de conteos, no una fila por ronda.
  @@unique([inventarioId, codigo])
  /// El indice que hace barata la pregunta del cliente: el historico de UN
  /// articulo a traves de todos los inventarios.
  @@index([codigo])
  @@index([inventarioId, diferencia])
  @@map("diferencias_item")
}

// ---------------------------------------------------------------------------
// Liquidacion v2: clasificacion manual y ajustes importados de Dynamics
// ---------------------------------------------------------------------------

/// Excepcion PERMANENTE del Auditor a la clasificacion empresa/empleado de
/// Dynamics, por CODIGO y no por inventario: el Auditor no quiere
/// reclasificar lo mismo cada mes. Caso real: productos de empresa que en
/// D365 figuran como Employee para forzar que entren al conteo.
///
/// Es la fuente VIVA y se lee AL LIQUIDAR (liquidacion.reclasificacion.ts):
/// lo que se aplico a cada inventario queda congelado en
/// DiferenciaItem.esEmpresa y en ResultadoInventario.montoFaltanteEmpresa y
/// montoSobranteEmpleado. Sin fila = sin excepcion, manda Dynamics. El
/// historial de cambios vive en RegistroAuditoria: esta tabla dice lo que
/// vale HOY.
/// (Ver `clase` mas abajo: la excepcion del Auditor tambien pasa a tres vias.)
model ClasificacionProducto {
  id        Int     @id @default(autoincrement())
  /// ItemNumber de Dynamics -- la identidad estable entre periodos (ver
  /// DiferenciaItem.codigo).
  codigo    String  @unique
  esEmpresa Boolean @map("es_empresa")
  /// LA EXCEPCION, A TRES VIAS -- ver el enum `ClaseItem`.
  ///
  /// Con el booleano solo se podia decir "esto lo paga la empresa" o "no". La
  /// regla del faltante por paquete agrega una tercera respuesta que el
  /// Auditor necesita poder dar: "esto viene en paquete, medile el umbral".
  /// Un item mal clasificado como `unidad` se descuenta entero al personal
  /// aunque falte media caja, que es justo lo que el cliente pidio cambiar.
  ///
  /// NULLABLE y aditiva: las excepciones cargadas antes de este cambio tienen
  /// NULL y las sigue mandando `esEmpresa` -- no se reinterpretan solas. Las
  /// nuevas escriben las dos, y `clase == empresa` tiene que coincidir con
  /// `esEmpresa == true` por lo mismo que en CatalogoItem: mientras las dos
  /// existan, no pueden discrepar.
  clase     ClaseItem? @map("clase")

  /// EL EMPAQUE DE COMPRA CORREGIDO A MANO por el Auditor.
  ///
  /// CORREGIR EL EMPAQUE NO ES CORREGIR EL STOCK, y conviene decirlo acá
  /// porque el dia que alguien lea esto las dos cosas se van a parecer y no lo
  /// son: el stock del ERP no lo edita nadie nunca desde ninguna pantalla. El
  /// empaque de compra es un ATRIBUTO del producto ("viene en display de 12")
  /// que Dynamics a veces tiene mal, y que el cliente pidio poder corregir.
  ///
  /// NO PISA `CatalogoItem.empaqueCompra`: ese es el snapshot congelado y
  /// tiene que seguir diciendo lo que dijo Dynamics. Los dos numeros conviven
  /// para que se pueda responder "el ERP dijo 1 y el Auditor lo corrigio a 12
  /// el 19/09", que es una historia, no un numero suelto.
  ///
  /// NULL = sin corregir, manda el del snapshot. Un 1 puesto a mano NO es lo
  /// mismo que NULL: afirma "este se compra suelto", y con eso el item nunca
  /// va al cuadro de paquetes (dominio/faltante-por-paquete.ts#claseEfectiva).
  ///
  /// PRECEDENCIA, el contrato con el calculo:
  ///   1. `clase` (el cuadro forzado a mano) -- manda sobre todo
  ///   2. `empaqueCompraCorregido` (esta columna)
  ///   3. `CatalogoItem.empaqueCompra` (el snapshot del ERP)
  ///   4. NULL -> `unidad` (no se inventa un paquete)
  empaqueCompraCorregido Int? @map("empaque_compra_corregido")

  nota      String?

  /// Quien y cuando, SIEMPRE juntos y explicitos (sin default): una
  /// reclasificacion mueve plata de un lado a otro de la liquidacion.
  clasificadoPorId Int         @map("clasificado_por_id")
  clasificadoPor   Colaborador @relation("ClasificadoPor", fields: [clasificadoPorId], references: [id])
  clasificadoEn    DateTime    @map("clasificado_en")

  @@map("clasificaciones_producto")
}

/// CABECERA de una importacion del Excel de ajustes de Dynamics ("Ajuste
/// por analisis de Inventarios / Sobrante unico por unidad", los manda el
/// area de negativos). Reemplaza al monto que se tipeaba a mano en
/// ResultadoInventario.montoNegativos.
///
/// EXISTE para sostener la regla NULL != 0 de liquidacion.ajustes.ts, que
/// con solo las lineas no se puede expresar:
///   - sin importacion vigente          -> montoNegativos NULL (bloquea liquidar)
///   - importacion vigente con 0 lineas -> 0 EXPLICITO: alguien identificado
///     subio el archivo y no habia nada.
/// Si quien y cuando vivieran en las lineas, un Excel vacio no dejaria
/// ninguna fila donde anotarlos, y "importe 0" seria indistinguible de
/// "nunca se importo".
model ImportacionAjustesDynamics {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  nombreArchivo  String      @map("nombre_archivo")
  importadoPorId Int         @map("importado_por_id")
  importadoPor   Colaborador @relation("ImportadoPor", fields: [importadoPorId], references: [id])
  importadoEn    DateTime    @default(now()) @map("importado_en")

  /// true = la importacion que cuenta; NULL = reemplazada por una posterior.
  /// NUNCA false -- mismo patron que Inventario.abierto: con el @@unique de
  /// abajo, a lo sumo UNA vigente por inventario. Re-importar un Excel
  /// corregido pasa la anterior a NULL en vez de borrarla, y sus lineas
  /// excluidas siguen existiendo con su firma.
  vigente Boolean? @default(true)

  lineas LineaAjusteDynamics[]

  @@unique([inventarioId, vigente])
  @@map("importaciones_ajustes_dynamics")
}

/// Una fila del Excel de ajustes, TAL CUAL vino (importe con su signo).
///
/// Obligatorio solo lo que la formula necesita (`importe`), lo que
/// identifica el articulo (`codigo`) y lo que ubica la fila en el archivo
/// (`fila`). El resto es nullable porque esto es un espejo del Excel: una
/// celda vacia es un dato (NULL), y que se rechaza al importar lo decide el
/// parser, no el esquema.
model LineaAjusteDynamics {
  id            Int                        @id @default(autoincrement())
  importacionId Int                        @map("importacion_id")
  importacion   ImportacionAjustesDynamics @relation(fields: [importacionId], references: [id])

  /// Numero de fila en la hoja, como la ve Excel -- para poder decirle al
  /// area de negativos "la fila 14 tiene mal el motivo".
  fila Int

  diario       String?
  descripcion  String?
  almacen      String?
  codigo       String
  nombre2      String?
  /// 4 decimales, igual que precioVenta: el ERP puede traer fracciones (kg).
  cantidad     Decimal?  @db.Decimal(12, 4)
  precio       Decimal?  @db.Decimal(12, 4)
  importe      Decimal   @db.Decimal(12, 2)
  motivoAjuste String?   @map("motivo_ajuste")
  registradoEn DateTime? @map("registrado_en")
  responsable  String?

  /// El Auditor puede QUITAR una linea antes de liquidar ("el area de
  /// negativos se equivoca en poner el motivo", Gilmer). Se marca, no se
  /// borra: la linea sigue a la vista, con quien la saco y por que. Los
  /// cuatro campos se escriben JUNTOS -- una exclusion sin firma es plata
  /// que alguien dejo de reconocerle al personal sin explicacion.
  /// montoNegativos suma solo las NO excluidas.
  excluida        Boolean      @default(false)
  excluidaPorId   Int?         @map("excluida_por_id")
  excluidaPor     Colaborador? @relation("ExcluidaPor", fields: [excluidaPorId], references: [id])
  excluidaEn      DateTime?    @map("excluida_en")
  motivoExclusion String?      @map("motivo_exclusion")

  /// Una fila del archivo aparece una sola vez por importacion. Tambien es
  /// el indice de "las lineas de esta importacion" (prefijo izquierdo).
  @@unique([importacionId, fila])
  @@map("lineas_ajuste_dynamics")
}

/// La planilla de descuentos de la Pantalla 6, una fila por colaborador.
///
/// Se persiste (en vez de recalcularse al vuelo desde el resultado) porque
/// es lo que la persona firma y lo que se le descuenta del sueldo: si el
/// padron cambia -- alguien se va, entra otro, se deshabilita una cuenta --
/// recalcular la planilla de agosto en noviembre daria otro numero, y el
/// recibo de sueldo de agosto ya se emitio. El historico guarda lo que
/// PASO, no lo que hoy daria la cuenta.
model LiquidacionColaborador {
  id           Int        @id @default(autoincrement())
  inventarioId Int        @map("inventario_id")
  inventario   Inventario @relation(fields: [inventarioId], references: [id])

  colaboradorId Int         @map("colaborador_id")
  colaborador   Colaborador @relation("ColaboradorLiquidado", fields: [colaboradorId], references: [id])
  /// Nombre y rol congelados al momento de liquidar, misma razon que
  /// AprobacionCierre.rolAlAprobar y DiferenciaItem.descripcion.
  nombreAlLiquidar String @map("nombre_al_liquidar")
  rolAlLiquidar    Rol    @map("rol_al_liquidar")

  /// Cumplio la asistencia COMPLETA: vino todos los dias del inventario.
  /// False = falto al menos uno, paga multa por cada dia y no cobra bono
  /// (Pantalla 6).
  ///
  /// CAMBIO DE SIGNIFICADO, en lockstep con
  /// `ResultadoInventario.colaboradoresAsistieron` -- aquel es CUANTOS, este
  /// es QUIENES, y el schema ya decia que no pueden discrepar. Antes era
  /// "vino alguna vez"; ahora es "vino todos los dias". Con un inventario de
  /// un solo dia las dos definiciones coinciden, que es el unico caso que
  /// existia hasta ahora.
  asistio Boolean

  /// CUANTOS DIAS VINO, congelado al liquidar igual que `nombreAlLiquidar`.
  ///
  /// Se guarda aunque parezca derivable, y esa es justamente la razon: el
  /// denominador (`ResultadoInventario.diasDelInventario`) y la tarifa
  /// (`ResultadoInventario.multaInasistencia`) estan en otra tabla, asi que
  /// sin esta columna la planilla de agosto solo puede mostrar "X de Y dias"
  /// DESPEJANDOLO de la multa (dias - multa/tarifa). Eso es derivar una
  /// parte a partir de un total, exactamente al reves de la regla que sigue
  /// todo el resto del schema (ver el comentario de Conteo): el dia que la
  /// tarifa se guarde redondeada, o que alguien toque una marca, la cuenta
  /// devuelve un numero de dias que nadie trabajo.
  ///
  /// Sale de `dominio/asistencia.ts#diasAsistidosPorColaborador` sobre las
  /// marcas del inventario, en la misma transaccion que la planilla.
  ///
  /// 0 por defecto, y con las planillas VIEJAS quiere decir "se liquido
  /// cuando la asistencia no se contaba por dia", no "no vino nunca": esas
  /// filas ya tienen la respuesta en `asistio`, que era binario. La pantalla
  /// que muestre "dias asistidos / dias del inventario" tiene que leer
  /// `ResultadoInventario.diasDelInventario` primero: si es 0, ese inventario
  /// es de los viejos y la fraccion no significa nada.
  diasAsistidos Int @default(0) @map("dias_asistidos")

  /// DIAS QUE FALTO Y EL AUDITOR LE PERDONO, congelados igual que
  /// `diasAsistidos` y POR SEPARADO de ellos a proposito (ver
  /// JustificacionAsistencia: el sello afirma `diasAsistidos`, y sumarlos ahi
  /// haria que el documento diga que alguien estuvo un dia que no estuvo).
  ///
  /// Para la PLATA se suman a los asistidos, en los dos efectos:
  ///     multa   = max(0, dias - diasAsistidos - diasJustificados) x tarifa
  ///     asistio = diasAsistidos + diasJustificados >= diasDelInventario
  ///
  /// Sin esta columna, "S/0 de multa con 1 de 3 dias" es una fila que no
  /// cierra y que nadie puede explicar seis meses despues. Misma razon que
  /// `diasAsistidos`: no se despeja de la multa, se guarda.
  ///
  /// 0 en las planillas firmadas antes de que existieran las
  /// justificaciones, y ahi significa "no habia justificaciones", que es el
  /// mismo numero que corresponde -- a diferencia de `diasAsistidos`, aca el
  /// 0 viejo no miente.
  diasJustificados Int @default(0) @map("dias_justificados")

  /// Las PARTES del descuento. El total (cuota + multa - bono) no se
  /// guarda: se calcula en historial.calculos.ts, misma regla que el
  /// `total` ausente de Conteo.
  cuotaBase         Decimal @map("cuota_base") @db.Decimal(12, 2)
  /// Multa TOTAL de esta persona en este inventario: tarifa por dia x dias
  /// faltados. Ya no es el monto fijo de un ausente -- ver
  /// `ResultadoInventario.multaInasistencia`, que paso a ser la tarifa.
  multaInasistencia Decimal @default(0) @map("multa_inasistencia") @db.Decimal(12, 2)
  /// Redistribucion del fondo de multas entre quienes SI asistieron: les
  /// baja la cuota (docs/pantallas.md, Pantalla 6).
  bonoAsistencia    Decimal @default(0) @map("bono_asistencia")    @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([inventarioId, colaboradorId])
  /// Misma regla del prefijo izquierdo que en Conteo: el @@unique de arriba
  /// sirve para "las liquidaciones de ESTE inventario", no para "todas las
  /// liquidaciones de ESTA persona" -- y esa segunda es la pregunta que el
  /// historico va a recibir ("cuanto se le descontó a X en el año").
  /// Preventivo y barato: ~1.450 filas al año.
  /// Ver backend/docs/rendimiento-db.md (H9).
  @@index([colaboradorId])
  @@map("liquidaciones_colaborador")
}

/// Credenciales de la integracion con Dynamics, cargadas desde la pantalla
/// de Configuracion del Administrador (RepositorioConfigDynamics).
///
/// FILA UNICA: `id` siempre vale 1. No es un descuido -- la integracion con
/// el ERP es una sola para todo el sistema, igual que el administrador no
/// pertenece a ninguna sucursal. Se modela como tabla y no como mas filas de
/// `Configuracion` porque el secreto necesita un tratamiento que las otras
/// configs no tienen: se cifra al guardar y NUNCA se devuelve por la API.
///
/// PRECEDENCIA sobre las variables de entorno D365_*: si hay una fila aca,
/// gana; si no, se cae a `.env`. Asi el sistema sigue andando exactamente
/// igual que antes hasta que alguien cargue las credenciales por pantalla,
/// y despues deja de depender de un archivo que solo una persona puede tocar.
model ConfigDynamics {
  /// Siempre 1 -- ver el comentario del modelo.
  id Int @id @default(1)

  tenantId String @map("tenant_id")
  clientId String @map("client_id")
  urlBase  String @map("url_base")
  /// "trv" para Market Trujillo. Vacio = se usa el del entorno.
  dataAreaId String @default("") @map("data_area_id")

  /// El secreto CIFRADO (AES-256-GCM), nunca en claro y nunca devuelto por
  /// la API -- ver config-dynamics.cifrado.ts. NULL = todavia no se cargo
  /// ninguno, que es distinto de "hay uno vacio".
  ///
  /// Se guarda como `iv:tagDeAutenticacion:textoCifrado` en hexadecimal. El
  /// tag es lo que hace que un secreto manipulado en la base falle al
  /// descifrar en vez de devolver basura silenciosamente.
  clientSecretCifrado String? @map("client_secret_cifrado")

  /// Quien la cargo por ultima vez y cuando: cambiar las credenciales del
  /// ERP es una accion de administracion y tiene que dejar rastro (ademas
  /// del RegistroAuditoria, que guarda el detalle sin el secreto).
  actualizadoPorId Int?         @map("actualizado_por_id")
  actualizadoPor   Colaborador? @relation("ConfigDynamicsActualizadaPor", fields: [actualizadoPorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("config_dynamics")
}

// ---------------------------------------------------------------------------
// Navegacion configurable
// ---------------------------------------------------------------------------

/// QUE VE CADA ROL EN EL HOME Y EN LA BARRA DE ABAJO, y en que orden.
///
/// Pedido del cliente, textual: "en la app actualmente tiene accesos rapidos,
/// que estos pueden ser manejados por el administrador por medio de roles al
/// igual que los menus, pero DEJAR LOS ROLES QUE YA TENEMOS Y SUS ACCESOS. De
/// esta manera como administrador controlamos todo esto y no esta
/// hardcodeado".
///
/// ---------------------------------------------------------------------------
/// ESTO ES PRESENTACION, NO AUTORIZACION
/// ---------------------------------------------------------------------------
/// Esconder una tarjeta es una comodidad; mostrarla NO es un permiso. Quien
/// decide que puede hacer cada rol sigue siendo el backend -- el
/// `requiereRol` de cada router y los `*.permisos.ts`. Apagar un acceso no le
/// saca a nadie un permiso y prenderlo no se lo da: si alguien entra igual por
/// otro camino, el backend lo frena lo mismo.
///
/// ---------------------------------------------------------------------------
/// LO QUE ESTA TABLA NO PUEDE HACER, Y ES A PROPOSITO
/// ---------------------------------------------------------------------------
/// No puede darle a un rol un elemento de otro. La lista blanca de cada rol
/// son las rutas de SU grupo (`mobile/app/<rol>/`, ver
/// navegacion.lista-blanca.ts): `/auditor/auditoria` no existe dentro de
/// `app/coordinador/`, asi que no hay forma de darsela. Eso protege el CONTEO
/// CIEGO -- si el Coordinador viera el stock del ERP con el ciclo abierto, le
/// alcanzaria con decir "ahi tendrian que ser 120" para que el inventario
/// cuadre sin haberse contado.
///
/// ---------------------------------------------------------------------------
/// QUE GUARDA Y QUE NO
/// ---------------------------------------------------------------------------
/// Guarda SOLO lo que el Administrador cambia: el orden y el prendido. El
/// texto de cada elemento (titulo, subtitulo, etiqueta) vive en el catalogo
/// del codigo (`navegacion.catalogo.ts`), que es la misma lista que el movil
/// lleva compilada como respaldo. Guardar el texto acá lo duplicaria, y el dia
/// que alguien corrija un subtitulo tendria que acordarse de correr una
/// migracion.
///
/// La fila NACE de la siembra con lo que hoy esta hardcodeado, en su orden
/// actual: el dia 1 despues de este cambio los cuatro roles ven exactamente lo
/// mismo que veian antes.
model ConfiguracionNavegacion {
  id      Int            @id @default(autoincrement())
  rol     Rol
  tipo    TipoNavegacion
  /// La CLAVE ESTABLE del elemento: la ruta para un acceso
  /// (`/auditor/ajuste`), el nombre de archivo para un tab (`ciclo`). No es un
  /// texto que se muestre -- es lo que une esta fila con el catalogo del
  /// codigo. Renombrarla es perder la configuracion de ese elemento.
  clave   String
  /// De menor a mayor. Se guardan enteros consecutivos al reordenar; el
  /// espacio entre numeros no significa nada.
  orden   Int
  /// Apagado NO es borrado: la fila queda, con su orden, para que el
  /// Administrador pueda volver a prenderla sin tener que acordarse de donde
  /// estaba. Un elemento que desaparece de la pantalla de configuracion no se
  /// puede recuperar.
  visible Boolean @default(true)

  /// Quien lo toco por ultima vez. NULL = como lo dejo la siembra, nadie lo
  /// cambio nunca. El detalle de cada cambio (que habia antes) vive en
  /// `registro_auditoria`: sacarle un acceso a un rol puede dejar a alguien
  /// sin poder trabajar un lunes a las 7 de la mañana.
  actualizadoPorId Int?         @map("actualizado_por_id")
  actualizadoPor   Colaborador? @relation("NavegacionActualizadaPor", fields: [actualizadoPorId], references: [id])
  actualizadoEn    DateTime     @updatedAt @map("actualizado_en")

  /// Un elemento aparece UNA vez por rol. Es lo que hace que la siembra sea
  /// idempotente y que reordenar no pueda duplicar una tarjeta.
  @@unique([rol, tipo, clave])
  /// La consulta de la app al iniciar sesion: "lo mio, en orden".
  @@index([rol, tipo, orden])
  @@map("configuracion_navegacion")
}
